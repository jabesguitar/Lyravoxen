<Application x:Class="Lyravoxen.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#071A38" Offset="0"/>
   <GradientStop Color="#06152F" Offset="0.58"/>
   <GradientStop Color="#040E22" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#102F5C" Offset="0"/>
   <GradientStop Color="#0B2450" Offset="0.55"/>
   <GradientStop Color="#081C3B" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Accent" Color="#00D9F5"/>
  <SolidColorBrush x:Key="TextMuted" Color="#B5C8E7"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#123A66"/>
   <Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#071A3B"/>
   <Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="BorderBrush" Value="#245B88"/>
   <Setter Property="Padding" Value="10"/>
   <Setter Property="Margin" Value="4"/>
  </Style>
 </Application.Resources>
</Application>
