<Application x:Class="Lyravoxen.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#101923"/>
  <SolidColorBrush x:Key="Panel" Color="#192735"/>
  <SolidColorBrush x:Key="Accent" Color="#39D6C5"/>
  <SolidColorBrush x:Key="TextMuted" Color="#A8BAC5"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#244052"/>
   <Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0D151D"/>
   <Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="BorderBrush" Value="#355064"/>
   <Setter Property="Padding" Value="10"/>
   <Setter Property="Margin" Value="4"/>
  </Style>
 </Application.Resources>
</Application>
