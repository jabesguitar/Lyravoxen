<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lyravoxen</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Lyravoxen</Product>
    <Company>Lyravoxen</Company>
    <Description>Estúdio de letras, sincronização musical e projeção</Description>
    <ApplicationIcon>Assets\Lyravoxen.ico</ApplicationIcon>
    <RootNamespace>Lyravoxen</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <SplashScreen Include="Assets\LyravoxenSplash.png" />
  </ItemGroup>
  <ItemGroup>
    <SplashScreen Include="Assets\\LyravoxenSplash_Windows.png" />
  </ItemGroup>
</Project>
