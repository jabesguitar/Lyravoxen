         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Button Grid.Column="0" Content="◀ Anterior" Click="BiblePrevious_Click" MinHeight="40" Margin="0,0,3,0"/>
         <Button Grid.Column="1" Content="Próximo ▶" Click="BibleNext_Click" MinHeight="40" Margin="3,0,0,0"/>
        </Grid>
        <Button Content="Projetar" Click="ProjectBibleSelection_Click" Background="#087F9E" MinHeight="48" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
        <Button Content="Limpar telão" Click="ClearBibleProjection_Click" MinHeight="38"/>
