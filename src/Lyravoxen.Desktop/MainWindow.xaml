      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="360"/>
     </Grid.ColumnDefinitions>

     <DockPanel Grid.Column="0" Margin="0,0,8,0">
