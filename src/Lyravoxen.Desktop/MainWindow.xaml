      </Grid>
     </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="4,8,4,0">
     <TextBlock x:Name="BibleStatusText" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock x:Name="BibleCopyrightText" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
   </Grid>
  </TabItem>
</TabControl>
 </Grid>
