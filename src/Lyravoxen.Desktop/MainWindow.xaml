          </Grid>
         </Border>
         <TextBlock x:Name="NextProjectionPreviewText" Grid.Row="2" Text="Próxima: —" Foreground="{DynamicResource Brush_B8CAD5}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2"/>
        </Grid>
       </Grid>
      </TabItem>
            <TabItem x:Name="ManualControlsTab" Header="Controles manuais">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="1.06*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Brush_07172C}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="13" Padding="8" Margin="0,0,8,0">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
