       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>

     <DockPanel Grid.Column="2" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="VERSÍCULOS — Ctrl ou Shift para vários · Enter ou duplo clique projeta" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="4,0,0,5"/>
      <ListBox x:Name="BibleVersesList" FontSize="15" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BibleVersesList_SelectionChanged" MouseDoubleClick="BibleVersesList_MouseDoubleClick" KeyDown="BibleVersesList_KeyDown">
      </ListBox>
     </DockPanel>

     <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
      <Grid>
