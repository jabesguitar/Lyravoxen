 </Grid></TabItem>
 <TabItem x:Name="ManualSyncTab" Header="Cadastrar letra">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="0,0,0,12">
    <TextBlock Text="CADASTRAR LETRA PARA ESTA MÚSICA" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold"/>
    <TextBlock Text="Quando a busca automática não encontrar a letra, procure nas fontes alternativas, copie a letra completa e cole aqui (uma frase por linha). Clique em Salvar e sincronizar: com a música tocando, o Lyravoxen reconhece o áudio, sincroniza a letra sozinho e já projeta cada trecho na prévia, na projeção própria e no Holyrics. Se a música ainda não estiver tocando, a sincronização começa assim que você der play." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <WrapPanel Margin="0,10,0,0">
     <Button Content="📋 Colar e limpar letra" Click="PasteCleanLyrics_Click" Padding="14,6" Margin="0,0,6,0" ToolTip="Cola o que você copiou, tira cifras, [Refrão], créditos e links e separa as estrofes"/>
     <Button Content="🔎 Buscar texto da letra" Click="FetchLyricsText_Click" Padding="14,6" Margin="0,0,6,0" ToolTip="Busca o texto da letra pelo intérprete e título, no Vagalume (precisa da chave gratuita)"/>
     <Button Content="⚙ Fonte de letras" Click="LyricSource_Click" Padding="14,6" Margin="0,0,6,0" ToolTip="Chave gratuita do Vagalume para buscar o texto da letra automaticamente"/>
     <Button Content="⏱ Estimar tempos (rascunho)" Click="EstimateTimings_Click" Padding="14,6" Margin="0,0,6,0" ToolTip="Distribui as estrofes pela duração da música em segundos. Se a música estiver tocando, o instante atual vira o começo da 1ª estrofe. Depois ajuste com Frase ◀/▶ ou marque por toque"/>
     <Button Content="⚡ Cadastro rápido" Click="QuickRegister_Click" Background="#087F9E" Padding="14,6" ToolTip="Pega a letra (catálogo ou área de transferência), reinicia a música e já começa a marcação por toque"/>
    </WrapPanel>
   </StackPanel>
   <TextBox x:Name="ManualLyricsBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" Padding="14" VerticalContentAlignment="Top" ToolTip="Letra completa: mantenha cada frase em uma linha. As estrofes em branco podem separar partes da música."/>
   <Grid Grid.Row="2" Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="Salvar e sincronizar" Click="SaveFullLyrics_Click" Background="#087F9E" Height="42" FontSize="14" Padding="18,8"/>
    <Button x:Name="AutoRecognitionButton" Grid.Column="1" Content="Iniciar reconhecimento automático" Click="ToggleAutoRecognition_Click" Background="#087F9E" Height="42" FontSize="14" Padding="18,8"/>
    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock x:Name="ManualSyncProgressText" Text="Cole a letra e clique em Salvar e sincronizar." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
     <TextBlock x:Name="ManualCurrentLineText" Text="Aguardando o reconhecimento da música..." Foreground="#F2F6F8" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
    <StackPanel>
     <TextBlock Text="MARCAÇÃO POR TOQUE — para músicas playback (sem voz)" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
     <TextBlock Text="Separe as estrofes por uma linha em branco. Com a música tocando, toque no botão (ou aperte Espaço) quando cada estrofe começar; Backspace desfaz a última marca. Um toque a mais depois da última estrofe conclui e salva." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <WrapPanel>
      <Button x:Name="TapStartButton" Content="Iniciar marcação por toque" Click="TapStart_Click" Background="#087F9E" MinHeight="38" Padding="16,6" Margin="0,0,6,4"/>
      <Button x:Name="TapMarkButton" Content="TOQUE · próxima estrofe (Espaço)" Click="TapMark_Click" IsEnabled="False" Background="#087F9E" MinHeight="38" MinWidth="250" Padding="16,6" FontWeight="Bold" Margin="0,0,6,4"/>
      <Button x:Name="TapUndoButton" Content="Desfazer (Backspace)" Click="TapUndo_Click" IsEnabled="False" MinHeight="38" Padding="14,6" Margin="0,0,6,4"/>
      <Button x:Name="TapFinishButton" Content="Concluir e salvar" Click="TapFinish_Click" IsEnabled="False" MinHeight="38" Padding="14,6" Margin="0,0,6,4"/>
      <Button x:Name="TapCancelButton" Content="Cancelar" Click="TapCancel_Click" IsEnabled="False" MinHeight="38" Padding="14,6" Margin="0,0,0,4"/>
     </WrapPanel>
     <TextBlock x:Name="TapProgressText" Text="Pronto para marcar." Foreground="#F2F6F8" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </TabItem>
 <TabItem Header="＋ Próxima música">
  <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="YoutubeSearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquise uma música ou cole um link do YouTube"/>
     <Button Grid.Column="1" Content="Pesquisar" Click="YoutubeSearch_Click"/>
     <Button Grid.Column="2" Content="Voltar" Click="YoutubeSearchBack_Click"/>
     <Button Grid.Column="3" Content="Avançar" Click="YoutubeSearchForward_Click"/>
     <Button Grid.Column="4" Content="Atualizar" Click="YoutubeSearchRefresh_Click"/>
     <Button Grid.Column="5" Content="Copiar link" Click="CopyBrowserLink_Click" ToolTip="Copiar o endereço da página aberta nesta aba"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6"><TextBlock Text="PESQUISA E FONTES DE LETRAS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,12,0"/><Button Content="＋ Nova aba" Click="NewBrowserTab_Click" Padding="14,6"/><Button Content="Fechar aba" Click="CloseBrowserTab_Click" Padding="14,6" Margin="6,0,0,0"/></DockPanel><WrapPanel Grid.Row="1" Margin="2,0,2,8"><Button Content="▶ YouTube" Tag="youtube" Click="OpenQuickSite_Click"/><Button Content="G Google" Tag="google" Click="OpenQuickSite_Click"/><Button Content="♫ Cifra Club" Tag="cifraclub" Click="OpenQuickSite_Click"/><Button Content="V Vagalume" Tag="vagalume" Click="OpenQuickSite_Click"/><Button Content="L Letras.mus.br" Tag="letras" Click="OpenQuickSite_Click"/><Button Content="♪ Ouvir Música" Tag="ouvir" Click="OpenQuickSite_Click"/><Button Content="✝ Harpa Cristã" Tag="harpa" Click="OpenQuickSite_Click"/></WrapPanel><TabControl x:Name="BrowserTabs" Grid.Row="2" Background="#07172C" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged"><TabItem Header="YouTube 1"><wv2:WebView2 x:Name="YoutubeSearchView"/></TabItem></TabControl></Grid>
   <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="PRÓXIMA MÚSICA" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="NextTrackText" Text="Pesquise e abra o vídeo desejado. A música atual continuará tocando." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/><TextBlock x:Name="NextLyricsText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="150"/><CheckBox x:Name="AutoAdvanceBox" Content="Tocar a próxima sozinha quando a música terminar" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" Checked="AutoAdvanceBox_Changed" Unchecked="AutoAdvanceBox_Changed"/></StackPanel>
     <StackPanel Grid.Column="1"><Button Content="Preparar próxima" Click="PrepareNext_Click" Background="#087F9E"/><Button Content="✅ Confirmar letra" Click="ConfirmNextLyrics_Click" Background="#087F9E" ToolTip="Salva na biblioteca a letra encontrada para a próxima música, para ela rodar no telão ao tocar"/><Button Content="🔎 Verificar letra" Click="VerifyNextLyrics_Click" ToolTip="Confere se a música preparada já tem letra (biblioteca ou catálogo) e mostra a prévia"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </TabItem> <TabItem Header="✦ Bíblia" x:Name="BibleWorkspaceTab">
   <TabItem.Resources>
    <ItemsPanelTemplate x:Key="BibleVerseGridPanel">
     <WrapPanel/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="BibleVerseListPanel">
     <VirtualizingStackPanel/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="BibleVerseNumberTemplate">
     <TextBlock Text="{Binding Number}" MinWidth="30" TextAlignment="Center" FontWeight="SemiBold"/>
    </DataTemplate>
    <DataTemplate x:Key="BibleVerseTextTemplate">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="36"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Number}" FontWeight="Bold" Opacity="0.7"/>
      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
     </Grid>
    </DataTemplate>
   </TabItem.Resources>
   <Grid Margin="18">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="4,0,4,10">
     <TextBlock Text="CENTRAL BÍBLICA" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="Digite ou escolha o versículo, confira a prévia e projete no Holyrics ou na projeção própria." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10,8" Margin="0,0,0,10">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="VERSÃO" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"/>
       <ComboBox x:Name="BibleSourceBox" Width="360" MinHeight="38" SelectionChanged="BibleSourceBox_SelectionChanged" ToolTip="A ARC vem do Holyrics. As versões marcadas como local usam a projeção própria.">
        <ComboBox.ItemTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Title}"/>
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
      </StackPanel>
      <Button Grid.Column="1" Content="↻ Holyrics" Click="RefreshHolyricsBibleVersions_Click" VerticalAlignment="Bottom" MinHeight="38" Margin="8,0,0,0" ToolTip="Buscar as Bíblias instaladas no Holyrics"/>
      <StackPanel Grid.Column="2" Margin="12,0,0,0">
       <TextBlock Text="REFERÊNCIA — Enter localiza · Ctrl+Enter projeta · ex.: Jo 3:16, Sl 23, 1 Co 13:4-7" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"/>
       <TextBox x:Name="BibleSearchBox" MinHeight="38" FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center" KeyDown="BibleSearchBox_KeyDown" TextChanged="BibleSearchBox_TextChanged"/>
      </StackPanel>
      <Button Grid.Column="3" Content="Localizar" Click="BibleLocate_Click" Background="#087F9E" VerticalAlignment="Bottom" MinHeight="38" Padding="20,6" Margin="8,0,0,0"/>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
       <TextBlock Text="MICROFONE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,8,0"/>
       <ComboBox x:Name="BibleMicDeviceBox" Width="300" MinHeight="36" Loaded="BibleMicDeviceBox_Loaded" SelectionChanged="BibleMicDeviceBox_SelectionChanged" ToolTip="Escolha o microfone ou a interface de áudio externa"/>
       <Button Content="↻" Click="RefreshMicDevices_Click" MinHeight="36" MinWidth="36" Margin="6,0,0,0" ToolTip="Procurar microfones e interfaces de áudio conectados"/>
       <Button x:Name="BibleMicButton" Content="🎙 Segure para falar (F4)" PreviewMouseLeftButtonDown="BibleMicButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="BibleMicButton_PreviewMouseLeftButtonUp" Background="#087F9E" MinHeight="36" Padding="18,6" Margin="12,0,0,0" ToolTip="Segure o botão (ou a tecla F4), fale a referência e solte. Ex.: João três dezesseis"/>
       <ProgressBar x:Name="BibleMicLevelBar" Width="150" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#00D9F5" Background="#071A3B" BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Nível do microfone: deve se mover quando você fala"/>
      </StackPanel>
      <Border x:Name="BibleVoiceConfirmPanel" Grid.Row="2" Grid.ColumnSpan="4" Visibility="Collapsed" Background="#071A3B" BorderBrush="#00D9F5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
         <TextBlock x:Name="BibleVoiceHeardText" Foreground="#F2F6F8" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
