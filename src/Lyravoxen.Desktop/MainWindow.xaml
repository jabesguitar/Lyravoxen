<Window x:Class="Lyravoxen.MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyravoxen" Height="860" Width="1440" MinHeight="680" MinWidth="1024" WindowState="Maximized"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
 <Window.Resources>
  <Style TargetType="{x:Type Button}"><Setter Property="Foreground" Value="#EAF3F7"/><Setter Property="Background" Value="#243E50"/><Setter Property="BorderBrush" Value="#36566A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#31566A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#176E68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#0D151D"/><Setter Property="BorderBrush" Value="#355064"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}"><Border x:Name="T" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="1"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="BorderBrush" Value="#26C6B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type ComboBox}"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Grid Margin="8,10,8,8">
 <TabControl x:Name="WorkspaceTabs" Background="{StaticResource Bg}" BorderThickness="0" TabStripPlacement="Top">
  <TabControl.ItemContainerStyle><Style TargetType="{x:Type TabItem}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Background" Value="{StaticResource Panel}"/></Style></TabControl.ItemContainerStyle><TabItem Header="▶ Ao vivo"><Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0,4,14">
   <StackPanel><TextBlock Text="LYRAVOXEN" Foreground="{StaticResource Accent}" FontSize="25" FontWeight="Bold"/><TextBlock Text="Música em sintonia com palavras." Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="ESTÚDIO DE LETRAS  •  WINDOWS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="9" Margin="0,0,0,12">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBox x:Name="YoutubeUrlBox" Width="260" VerticalContentAlignment="Center" ToolTip="Cole aqui o link do YouTube"/>
     <Button Content="Limpar telão (Holyrics)" Click="CloseHolyricsPresentation_Click" Background="#713C48" ToolTip="Remove imediatamente a apresentação que está no Holyrics."/>
     <Button x:Name="LoadYoutubeButton" Content="Carregar YouTube" Click="LoadYoutube_Click" Background="#176E68"/>
     <Button Content="Abrir projeção" Click="OpenProjection_Click" ToolTip="Abre o telão no monitor selecionado."/>
     <Button x:Name="PlayNextButton" Content="Tocar próxima" Click="PlayNextPrepared_Click" IsEnabled="False" ToolTip="Carrega a música preparada na aba Próxima música."/>
     <Button Content="Encerrar projeção" Click="EndProjection_Click" Background="#8C3B42" ToolTip="Fecha a janela de saída do Lyravoxen e solicita a limpeza no Holyrics."/>
    </WrapPanel>
    <Expander Header="Ferramentas e configuração" Foreground="{StaticResource TextMuted}" Margin="3,4,3,0">
     <WrapPanel Margin="0,4,0,0">
      <Button Content="Holyrics: configurar" Click="HolyricsSettings_Click" ToolTip="Configura endereço, porta e token da integração."/>
      <Button Content="Testar Holyrics" Click="TestHolyrics_Click" ToolTip="Envia uma frase de teste diretamente ao Holyrics."/>
      <Button Content="Testar projeção" Click="TestProjection_Click" ToolTip="Envia uma frase de teste ao telão."/>
      <Button Content="Tela de espera" Click="ProjectionStandby_Click" ToolTip="Exibe a mensagem de espera."/>
      <Button Content="Tela final" Click="ProjectionEnding_Click" ToolTip="Exibe a mensagem de encerramento."/>
      <Button Content="Diagnóstico" Click="RunDiagnostics_Click" ToolTip="Verifica as condições principais da apresentação."/>
      <ComboBox x:Name="OutputDisplayBox" Width="175" Margin="3" VerticalContentAlignment="Center" ToolTip="Escolha a tela onde as letras serão projetadas" SelectionChanged="OutputDisplay_SelectionChanged"/>
      <TextBlock Text="Atalho para limpar o telão: Ctrl+F9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,3"/>
     </WrapPanel>
    </Expander>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#080D12" CornerRadius="12" Padding="8" Margin="0,0,8,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="REPRODUÇÃO — PLAYER OFICIAL DO YOUTUBE" Foreground="{StaticResource TextMuted}" Margin="8"/>
     <wv2:WebView2 x:Name="YoutubePlayer" Grid.Row="1"/>
     <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="8,0,0,0">
    <TabControl Background="{StaticResource Panel}" BorderThickness="0">
     <TabItem Header="Sincronização">
      <Grid Margin="3">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="92"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="SINCRONIZAÇÃO DA LETRA" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" Margin="4,3,4,5" ToolTip="Cadastre ou sincronize as frases da música."/>
       <Grid Grid.Row="1" Margin="2,0,2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="TÍTULO DA MÚSICA" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="2,2,3,0"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="AUTOR / INTÉRPRETE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="2,2,2,0"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="COMPOSITOR (OPCIONAL)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="3,2,0,0"/>
        <TextBox x:Name="MusicTrackBox" Grid.Row="1" Grid.Column="0" Margin="0,0,3,3" ToolTip="Título da música"/>
        <TextBox x:Name="MusicArtistBox" Grid.Row="1" Grid.Column="1" Margin="2,0,2,3" ToolTip="Nome do autor ou intérprete"/>
        <TextBox x:Name="MusicComposerBox" Grid.Row="1" Grid.Column="2" Margin="3,0,0,3" ToolTip="Compositor da música (opcional)"/>
        <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Buscar letra sincronizada" Click="SearchLyrics_Click" Background="#176E68" Margin="0,2,0,0" MinHeight="27"/>
       </Grid>
       <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="3,0,3,3">
        <TextBlock Text="Linhas:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox x:Name="LineCountBox" Width="52" SelectedIndex="3" SelectionChanged="LineCount_SelectionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox>
        <TextBlock Text="Tema:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <ComboBox x:Name="ProjectionThemeBox" Width="112" SelectedIndex="0" SelectionChanged="ProjectionTheme_SelectionChanged"><ComboBoxItem Content="Noturno"/><ComboBoxItem Content="Clássico"/><ComboBoxItem Content="Âmbar"/></ComboBox>
       </StackPanel>
       <Border Grid.Row="3" MaxHeight="82" Background="#0D151D" BorderBrush="#355064" BorderThickness="1" CornerRadius="7" Padding="6" Margin="3,2,3,4">
        <StackPanel>
         <TextBlock Text="PRÉVIA DO TELÃO" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
         <TextBox x:Name="ProjectionPreviewText" Text="Aguardando uma frase sincronizada..." Foreground="#F2F6F8" Background="#0D151D" BorderThickness="0" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="25" MaxHeight="32" VerticalScrollBarVisibility="Auto" ToolTip="Edite manualmente o texto que deseja projetar. Clique em Aplicar prévia para enviar ao telão."/>
         <TextBlock x:Name="NextProjectionPreviewText" Text="Próxima: —" Foreground="{StaticResource TextMuted}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
       </Border>
       <ListBox x:Name="CueList" Grid.Row="4" MinHeight="92" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="CueList_SelectionChanged" Margin="3"/>
       <UniformGrid Grid.Row="5" Columns="4" Rows="2" Margin="1,2,1,3">
        <Button Content="◀ Anterior" Click="PreviousCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27" ToolTip="Seleciona a frase anterior."/>
        <Button Content="Próxima ▶" Click="NextCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27" ToolTip="Seleciona a próxima frase."/>
        <Button Content="Projetar" Click="ProjectSelectedCue_Click" Background="#176E68" FontSize="10" Padding="3,3" Margin="1" MinHeight="27" ToolTip="Projeta a frase selecionada."/>
        <Button Content="Automático" Click="ResumeAutomaticProjection_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27" ToolTip="Retoma a sincronização automática."/>
        <Button Content="Editar" Click="EditCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27"/>
        <Button Content="Atualizar" Click="UpdateCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27"/>
        <Button Content="Excluir" Click="DeleteCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27"/>
        <Button Content="Reordenar" Click="MoveCue_Click" FontSize="10" Padding="3,3" Margin="1" MinHeight="27" ToolTip="Use Shift para mover a frase para baixo."/>
       </UniformGrid>
       </Grid>
     </TabItem>
     <TabItem Header="Sincronização manual">
      <ScrollViewer Margin="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <TextBlock Text="FERRAMENTAS DE SINCRONIZAÇÃO MANUAL" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" Margin="4,4,4,8"/>
        <TextBlock Text="Aplique o texto editado na prévia, cadastre frases por tempo ou sincronize uma letra inteira manualmente." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,0,4,8"/>
        <Button Content="Aplicar prévia editada" Click="ApplyProjectionPreview_Click" Background="#176E68" FontSize="11" Padding="7,6" Margin="2,3" ToolTip="Envia ao telão exatamente o texto que está editado na prévia."/>
        <Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="SecondsBox" Grid.Column="0" Text="0" ToolTip="Tempo em segundos"/>
         <TextBox x:Name="LyricTextBox" Grid.Column="1" ToolTip="Digite a frase da letra"/>
         <Button Grid.Column="2" Content="Adicionar tempo" Click="AddCue_Click" FontSize="10"/>
        </Grid>
        <Button Content="Marcar frase no tempo atual" Click="MarkCueAtCurrentTime_Click" Background="#176E68" FontSize="10" Margin="2,3"/>
        <TextBlock Text="Marque cerca de 1,5 segundo antes de a frase começar." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,2"/>
        <Button Content="Importar letra sincronizada (.LRC / .SRT)" Click="ImportLyrics_Click" Margin="2,3" FontSize="10"/>
        <Button Content="Importar música do Holyrics (playback)" Click="ImportHolyricsSong_Click" Margin="2,3" Background="#176E68" FontSize="10"/>
        <CheckBox x:Name="CaptureCueTimesCheckBox" Content="Gravar tempos ao avançar (playback instrumental)" IsChecked="False" Margin="4,5" FontSize="10" ToolTip="Ao pressionar Próxima durante a música, registra o tempo atual para sincronizar esta sequência nas próximas reproduções."/>
        <Border Background="#14232D" BorderBrush="#355064" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2,6">
         <StackPanel>
          <TextBlock Text="COLAR LETRA E SINCRONIZAR MANUALMENTE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11" Margin="2,0,2,5"/>
          <TextBox x:Name="PastedLyricsBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Cole a letra completa. Coloque cada verso em uma linha."/>
          <Button Content="Carregar letra colada" Click="LoadPastedLyrics_Click" Margin="0,4,0,0" FontSize="10"/>
          <Button Content="Marcar próximo verso no tempo atual" Click="MarkNextPastedLyric_Click" Background="#176E68" Margin="0,4,0,0" FontSize="10" ToolTip="Registra o tempo do player para a próxima linha da letra e a salva na biblioteca."/>
          <TextBlock Text="Cole um verso por linha, carregue, dê play e marque cada verso quando começar. Os tempos serão salvos para as próximas reproduções." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="9" Margin="2,5,2,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="Histórico de vídeos">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="VÍDEOS UTILIZADOS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <TextBox x:Name="HistorySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar pelo título do vídeo" TextChanged="HistorySearch_TextChanged"/>
        <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar histórico" Click="HistorySearch_Click"/>
       </Grid>
       <ListBox x:Name="HistoryList" Grid.Row="2" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="4" SelectionChanged="HistoryList_SelectionChanged" DisplayMemberPath="Title"/>
       <TextBlock Grid.Row="3" Text="Selecione um título para carregar novamente o vídeo." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="6,8,4,2"/>
      </Grid>
     </TabItem>
     <TabItem Header="Biblioteca">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="MINHAS COLEÇÕES" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,8,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="LibraryFolderList" Grid.Row="0" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="LibraryFolder_SelectionChanged" DisplayMemberPath="Name"/>
         <Button Grid.Row="1" Content="＋ Criar pasta" Click="CreateFolder_Click" Margin="0,8,0,0"/>
         <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Renomear" Click="RenameFolder_Click"/>
          <Button Grid.Column="1" Content="Excluir" Click="DeleteFolder_Click"/>
         </Grid>
        </Grid>
        <Grid Grid.Column="1" Margin="8,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <TextBox x:Name="LibrarySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar nesta pasta" TextChanged="LibrarySearch_TextChanged"/>
          <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar músicas" Click="LibrarySearch_Click"/>
         </Grid>
         <ListBox x:Name="LibrarySongList" Grid.Row="1" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="0,8,0,8" DisplayMemberPath="Title" SelectionChanged="LibrarySong_SelectionChanged"/>
         <StackPanel Grid.Row="2"><Button Content="＋ Adicionar vídeo atual a esta pasta" Click="AddCurrentVideoToFolder_Click"/><Button Content="＋ Salvar letra/hino sem vídeo" Click="SaveLyricsOnly_Click" Margin="0,5,0,0" Background="#176E68" ToolTip="Guarda título, autor, intérprete e letra sincronizada mesmo sem vídeo ou áudio."/><Button Content="＋ Importar áudio MP3/WAV para uso offline" Click="ImportAudio_Click" Margin="0,5,0,0"/></StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="Pronto. Cole um link do YouTube para começar." Foreground="{StaticResource TextMuted}" Margin="6,12,0,0"/>
 </Grid></TabItem>
 <TabItem Header="＋ Próxima música">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="YoutubeSearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Digite um endereço completo ou pesquise no YouTube" KeyDown="YoutubeSearchBox_KeyDown"/>
     <Button Grid.Column="1" Content="Ir" Click="YoutubeSearch_Click" ToolTip="Abrir endereço ou pesquisar"/>
     <Button Grid.Column="2" Content="←" Click="YoutubeSearchBack_Click" ToolTip="Voltar"/>
     <Button Grid.Column="3" Content="→" Click="YoutubeSearchForward_Click" ToolTip="Avançar"/>
     <Button Grid.Column="4" Content="⟳" Click="YoutubeSearchRefresh_Click" ToolTip="Atualizar"/>
     <Button Grid.Column="5" Content="Início" Click="YoutubeSearchHome_Click" ToolTip="Abrir YouTube"/>
     <Button Grid.Column="6" Content="Colar" Click="YoutubeSearchPaste_Click" ToolTip="Colar endereço copiado"/>
     <Button Grid.Column="7" Content="Copiar URL" Click="YoutubeSearchCopy_Click" ToolTip="Copiar endereço da página atual"/>
    </Grid>
   </Border>
   <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="8" Margin="0,0,0,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="IDENTIFICAÇÃO DA MÚSICA — TÍTULO E CANTOR" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="4,0,4,3"/>
     <TextBlock Grid.Row="1" Grid.Column="0" Text="Título da música / nº do hino" Foreground="{StaticResource TextMuted}" Margin="4,2,4,3"/>
     <TextBlock Grid.Row="1" Grid.Column="1" Text="Cantor / intérprete (opcional)" Foreground="{StaticResource TextMuted}" Margin="4,2,4,3"/>
     <TextBox x:Name="SearchTrackBox" Grid.Row="2" Grid.Column="0" ToolTip="Digite o título da música ou o número do hino" VerticalContentAlignment="Center"/>
     <TextBox x:Name="SearchArtistBox" Grid.Row="2" Grid.Column="1" ToolTip="Digite o cantor ou intérprete, se souber" VerticalContentAlignment="Center"/>
     <Button Grid.Row="2" Grid.Column="2" Content="Buscar letra" Click="SearchLyricsFromBrowser_Click" Background="#176E68"/>
     <Button Grid.Row="2" Grid.Column="3" Content="Sites gospel" Click="SearchHymnSources_Click" Margin="4,0,0,0" ToolTip="Pesquisar em portais especializados em hinos e louvores"/>
     <Button Grid.Row="2" Grid.Column="4" Content="Sites gerais" Click="SearchLyricsSources_Click" Margin="4,0,0,0" ToolTip="Pesquisar em portais gerais de letras e música"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6"><TextBlock Text="ABAS DO NAVEGADOR" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,12,0"/><Button Content="＋ Nova aba" Click="NewBrowserTab_Click" Padding="14,6"/><Button Content="Fechar aba" Click="CloseBrowserTab_Click" Padding="14,6" Margin="6,0,0,0"/></DockPanel><TabControl x:Name="BrowserTabs" Grid.Row="1" Background="#080D12" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged"><TabItem Header="YouTube 1"><wv2:WebView2 x:Name="YoutubeSearchView"/></TabItem></TabControl></Grid>
   <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="PRÓXIMA MÚSICA" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="NextTrackText" Text="Pesquise e abra o vídeo desejado. A música atual continuará tocando." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="1" Content="Preparar próxima" Click="PrepareNext_Click" Background="#176E68"/>
    </Grid>
   </Border>
  </Grid>
 </TabItem>
 <TabItem Header="Ajuda">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22">
   <StackPanel MaxWidth="1050">
    <TextBlock Text="GUIA RÁPIDO DO LYRAVOXEN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
    <TextBlock Text="APRESENTAÇÃO E TELÃO" FontWeight="Bold" FontSize="15" Margin="0,8,0,4"/>
    <TextBlock Text="Abrir projeção: abre a janela de saída no monitor escolhido. Use quando o telão ainda não estiver aberto. Testar projeção: envia uma frase de teste para conferir o monitor antes da apresentação." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Tela de espera: mostra uma mensagem enquanto você prepara a música. Encerrar: mostra a mensagem de agradecimento. Esc na janela de projeção limpa a tela." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Diagnóstico: verifica as condições principais detectáveis da apresentação. Não substitui um teste real do telão. Holyrics: abre as configurações da integração; configure e teste a conexão antes de usar." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Trocar próxima música: prepara a faixa aberta na aba Próxima música sem interromper a atual. Depois, use Tocar próxima para carregá-la." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="LETRAS E SINCRONIZAÇÃO" FontWeight="Bold" FontSize="15" Margin="0,12,0,4"/>
    <TextBlock Text="Título é o nome da música. Intérprete é quem canta. Autor/compositor é quem escreveu a obra; pode ser diferente do intérprete." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Linhas simultâneas (1 a 10): define quantas frases formam uma página. Exemplo: 2 mostra as linhas 1 e 2 juntas; quando começa a linha 3, ambas saem e entram 3 e 4. O último bloco pode ter menos linhas." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Prévia do telão: edite o texto diretamente e clique Aplicar prévia editada para enviar exatamente o texto digitado. Isso pausa o automático; clique Automático para retomar a sincronização." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Anterior/Próxima: percorrem as frases. Projetar envia a selecionada ou o bloco correspondente. Automático devolve o controle ao relógio da música." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Editar: carrega a frase nos campos de tempo e texto. Atualizar: grava as alterações. Excluir: remove a frase após confirmação. Reordenar: clique para mover para cima; segure Shift e clique para mover para baixo. A ordem é ajustada pelos tempos." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Adicionar tempo cadastra a frase digitada usando o tempo em segundos. Marcar frase no tempo atual usa o instante do player. Importar letra aceita LRC/SRT; Importar música do Holyrics traz os slides para avanço manual. Para letras sem sincronização, a aba Sincronização manual permite colar um verso por linha e marcar cada início durante a reprodução. Esse processo ainda é manual: o botão Carregar letra colada não calcula os tempos automaticamente." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Salvar letra/hino sem vídeo: na aba Biblioteca, selecione uma pasta e clique nesse botão. Ele guarda título, intérprete, compositor e frases sincronizadas mesmo sem um link ou arquivo de áudio. Depois, selecione o item salvo para abrir a letra e projetá-la manualmente." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="FILA E ATALHOS" FontWeight="Bold" FontSize="15" Margin="0,12,0,4"/>
    <TextBlock Text="Na aba Próxima música, cole um link na barra superior e clique Ir. Colar insere o endereço da área de transferência; Copiar URL copia a página atual. Abra o vídeo desejado e clique Preparar próxima." TextWrapping="Wrap" Margin="0,2"/>
    <TextBlock Text="Atalhos: F6 anterior; F7 próxima; F8 projetar; F9 automático; F10 restaurar projeção; F11 tela de espera; F12 tela final; ESC fecha a janela do telão e volta à área de trabalho; Ctrl+F9 solicita a limpeza do conteúdo projetado no Holyrics. Esse comando não fecha o programa Holyrics nem garante o fechamento da apresentação; ele envia a ação de limpar conteúdo pela integração. Os atalhos do operador não atuam enquanto você digita em campos de texto." TextWrapping="Wrap" Margin="0,2"/>
   </StackPanel>
  </ScrollViewer>
 </TabItem>
 </TabControl>
 </Grid>
