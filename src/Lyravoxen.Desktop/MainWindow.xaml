        <Border Grid.Column="0" Background="{DynamicResource Brush_07172C}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="13" Padding="8" Margin="0,0,8,0">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="FRASES SINCRONIZADAS" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold" Margin="4,4,4,8"/>
