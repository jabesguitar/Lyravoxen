      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="VERSÃO" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"/>
       <ComboBox x:Name="BibleSourceBox" Width="360" MinHeight="38" SelectionChanged="BibleSourceBox_SelectionChanged" ToolTip="A ARC vem do Holyrics. As versões marcadas como local usam a projeção própria.">
        <ComboBox.ItemTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Title}"/>
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
      </StackPanel>
      <Button Grid.Column="1" Content="↻ Holyrics" Click="RefreshHolyricsBibleVersions_Click" VerticalAlignment="Bottom" MinHeight="38" Margin="8,0,0,0" ToolTip="Buscar as Bíblias instaladas no Holyrics"/>
      <StackPanel Grid.Column="2" Margin="12,0,0,0">
       <TextBlock Text="REFERÊNCIA — Enter localiza · Ctrl+Enter projeta · ex.: Jo 3:16, Sl 23, 1 Co 13:4-7" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"/>
       <TextBox x:Name="BibleSearchBox" MinHeight="38" FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center" KeyDown="BibleSearchBox_KeyDown" TextChanged="BibleSearchBox_TextChanged"/>
      </StackPanel>
      <Button Grid.Column="3" Content="Localizar" Click="BibleLocate_Click" Background="{DynamicResource Brush_087F9E}" VerticalAlignment="Bottom" MinHeight="38" Padding="20,6" Margin="8,0,0,0"/>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
       <TextBlock Text="MICROFONE" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,8,0"/>
       <ComboBox x:Name="BibleMicDeviceBox" Width="300" MinHeight="36" Loaded="BibleMicDeviceBox_Loaded" SelectionChanged="BibleMicDeviceBox_SelectionChanged" ToolTip="Escolha o microfone ou a interface de áudio externa"/>
       <Button Content="↻" Click="RefreshMicDevices_Click" MinHeight="36" MinWidth="36" Margin="6,0,0,0" ToolTip="Procurar microfones e interfaces de áudio conectados"/>
       <Button x:Name="BibleMicButton" Content="🎙 Segure para falar (F4)" PreviewMouseLeftButtonDown="BibleMicButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="BibleMicButton_PreviewMouseLeftButtonUp" Background="{DynamicResource Brush_087F9E}" MinHeight="36" Padding="18,6" Margin="12,0,0,0" ToolTip="Segure o botão (ou a tecla F4), fale a referência e solte. Ex.: João três dezesseis"/>
       <ProgressBar x:Name="BibleMicLevelBar" Width="150" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="{DynamicResource Brush_00D9F5}" Background="{DynamicResource Brush_071A3B}" BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Nível do microfone: deve se mover quando você fala"/>
      </StackPanel>
      <Border x:Name="BibleVoiceConfirmPanel" Grid.Row="2" Grid.ColumnSpan="4" Visibility="Collapsed" Background="{DynamicResource Brush_071A3B}" BorderBrush="{DynamicResource Brush_00D9F5}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
         <TextBlock x:Name="BibleVoiceHeardText" Foreground="{DynamicResource Brush_F2F6F8}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
         <TextBlock x:Name="BibleVoiceHintText" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="BibleVoiceConfirmButton" Grid.Column="1" Content="✔ Projetar (Enter)" Click="BibleVoiceConfirm_Click" Background="{DynamicResource Brush_087F9E}" MinHeight="38" Padding="18,6" Margin="10,0,0,0"/>
        <Button Grid.Column="2" Content="✖ Descartar (Esc)" Click="BibleVoiceDiscard_Click" MinHeight="38" Padding="14,6" Margin="6,0,0,0"/>
       </Grid>
      </Border>
     </Grid>
    </Border>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170"/>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="1.12*"/>
      <ColumnDefinition Width="1.0*"/>
     </Grid.ColumnDefinitions>

     <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="LIVROS" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" Margin="4,0,0,5"/>
      <ListBox x:Name="BibleBooksList" FontSize="14" SelectionChanged="BibleBooksList_SelectionChanged">
       <ListBox.GroupStyle>
        <GroupStyle>
         <GroupStyle.HeaderTemplate>
          <DataTemplate>
           <Border Background="{DynamicResource Brush_123A66}" CornerRadius="5" Padding="8,5" Margin="0,6,0,3">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush_00D9F5}" FontSize="11" FontWeight="Bold"/>
           </Border>
          </DataTemplate>
         </GroupStyle.HeaderTemplate>
        </GroupStyle>
       </ListBox.GroupStyle>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>

     <DockPanel Grid.Column="1" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="CAPÍTULOS" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" Margin="4,0,0,5"/>
      <ListBox x:Name="BibleChaptersList" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BibleChaptersList_SelectionChanged">
       <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
         <WrapPanel/>
        </ItemsPanelTemplate>
       </ListBox.ItemsPanel>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding}" MinWidth="30" TextAlignment="Center" FontWeight="SemiBold"/>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>

     <DockPanel Grid.Column="2" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="VERSÍCULOS — Ctrl ou Shift para vários · Enter ou duplo clique projeta" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" Margin="4,0,0,5"/>
      <ListBox x:Name="BibleVersesList" FontSize="15" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BibleVersesList_SelectionChanged" MouseDoubleClick="BibleVersesList_MouseDoubleClick" KeyDown="BibleVersesList_KeyDown">
      </ListBox>
     </DockPanel>

     <Border Grid.Column="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Brush_00AFCB}" BorderThickness="1" CornerRadius="16" Padding="12" MinWidth="360">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock Grid.Row="0" x:Name="BiblePreviewReferenceText" Text="Nenhum versículo selecionado" Foreground="{DynamicResource Accent}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
       <Border Grid.Row="1" Background="{DynamicResource Brush_020A18}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,10" ClipToBounds="True">
        <Grid>
         <Image Source="pack://siteoforigin:,,,/Assets/Lyravoxen_Icone_App_1024.png" Opacity="0.055" Stretch="Uniform" IsHitTestVisible="False"/>
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="BiblePreviewVerseText" Text="Digite uma referência ou escolha livro, capítulo e versículo." Foreground="{DynamicResource Brush_F2F6F8}" FontSize="20" TextWrapping="Wrap" LineHeight="29" Margin="4"/>
         </ScrollViewer>
        </Grid>
       </Border>
       <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="BibleSourceNoteText" Grid.Row="0" Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,3"/>
        <UniformGrid Grid.Row="1" Columns="4">
         <Button Content="◀ Anterior" Click="BiblePrevious_Click" MinHeight="38" Margin="2"/>
         <Button Content="Próximo ▶" Click="BibleNext_Click" MinHeight="38" Margin="2"/>
         <Button Content="Projetar" Click="ProjectBibleSelection_Click" Background="{DynamicResource Brush_087F9E}" MinHeight="38" FontWeight="Bold" Margin="2"/>
         <Button Content="Limpar telão" Click="ClearBibleProjection_Click" MinHeight="38" Margin="2"/>
        </UniformGrid>
       </Grid>
      </Grid>
     </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="4,8,4,0">
     <TextBlock x:Name="BibleStatusText" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock x:Name="BibleCopyrightText" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
   </Grid>
  </TabItem>

 <TabItem x:Name="OfflineLibraryTab"><TabItem.Header>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Border Width="29" Height="29" CornerRadius="15" Background="{DynamicResource Brush_00AFCB}" BorderBrush="{DynamicResource Brush_FFFFFF}" BorderThickness="1.5" Margin="0,0,8,0">
    <TextBlock Text="♫" Foreground="{DynamicResource Brush_FFFFFF}" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock Text="Biblioteca Offline" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
  </StackPanel>
 </TabItem.Header>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="4,0,4,10">
   <DockPanel LastChildFill="True" Margin="0,0,0,6">
    <Button DockPanel.Dock="Right" Content="📁 Escolher pasta de armazenamento" Click="ChooseOfflineStorageFolder_Click" MinHeight="32" Padding="12,5" Margin="8,0,0,0"/>
    <TextBlock x:Name="OfflineStoragePathText" Text="Armazenamento local do Lyravoxen" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <TextBlock Text="BIBLIOTECA OFFLINE" Foreground="{DynamicResource Accent}" FontSize="18" FontWeight="Bold"/>
   <TextBlock Text="Histórico de vídeos e coleções de músicas em um só lugar." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
  </StackPanel>
  <TabControl Grid.Row="1" Background="{DynamicResource Panel}" BorderThickness="0" MinHeight="370">
   <TabItem Header="Histórico de vídeos">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="13" Padding="10" Margin="0,0,8,0">
         <StackPanel>
          <TextBlock Text="PESQUISAR HISTÓRICO" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="13" Margin="2,4,2,8"/>
          <TextBox x:Name="HistorySearchBox" VerticalContentAlignment="Center" ToolTip="Pesquisar pelo título do vídeo" TextChanged="HistorySearch_TextChanged"/>
          <Button Content="⌕ Pesquisar" Click="HistorySearch_Click" Background="{DynamicResource Brush_087F9E}"/>
          <TextBlock Text="Selecione uma música na lista central para conferir os dados e carregá-la novamente." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="6,8,4,2"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Brush_07172C}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="13" Padding="8" Margin="0,0,8,0">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="MÚSICAS UTILIZADAS" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold" Margin="4,4,4,8"/>
          <ListBox x:Name="HistoryList" Grid.Row="1" Background="{DynamicResource Brush_071A3B}" Foreground="{DynamicResource Brush_F2F6F8}" BorderBrush="{DynamicResource Brush_245B88}" SelectionChanged="HistoryList_SelectionChanged" DisplayMemberPath="Title"/>
         </Grid>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Brush_0B2450}" BorderBrush="{DynamicResource Brush_00AFCB}" BorderThickness="1" CornerRadius="13" Padding="12">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="MÚSICA SELECIONADA" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold" Margin="3,3,3,10"/>
          <Border Grid.Row="1" Background="{DynamicResource Brush_020A18}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="11" Padding="14">
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedItem.Title, ElementName=HistoryList}" Foreground="{DynamicResource Brush_FFFFFF}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Selecione um registro no histórico para visualizar o título desta faixa." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="4,12,4,0"/>
           </StackPanel>
          </Border>
          <TextBlock Grid.Row="2" Text="O histórico mantém os nomes cadastrados para facilitar a reutilização das músicas." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="4,8,4,2"/>
         </Grid>
        </Border>
       </Grid>
      </TabItem>
   <TabItem Header="Biblioteca">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="13" Padding="9" Margin="0,0,8,0">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="PASTAS E COLEÇÕES" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" Margin="4,4,4,8"/>
          <ListBox x:Name="LibraryFolderList" Grid.Row="1" Background="{DynamicResource Brush_071A3B}" Foreground="{DynamicResource Brush_F2F6F8}" BorderBrush="{DynamicResource Brush_245B88}" SelectionChanged="LibraryFolder_SelectionChanged" DisplayMemberPath="Name"/>
          <StackPanel Grid.Row="2">
           <Button Content="＋ Criar pasta" Click="CreateFolder_Click"/>
           <Button Content="Renomear" Click="RenameFolder_Click"/>
           <Button Content="Excluir" Click="DeleteFolder_Click"/>
          </StackPanel>
         </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Brush_07172C}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="13" Padding="9" Margin="0,0,8,0">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
           <TextBlock Text="MÚSICAS DA COLEÇÃO" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" Margin="4,4,4,5"/>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
            <TextBox x:Name="LibrarySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar nesta pasta" TextChanged="LibrarySearch_TextChanged"/>
            <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar músicas" Click="LibrarySearch_Click"/>
           </Grid>
          </StackPanel>
          <ListBox x:Name="LibrarySongList" Grid.Row="1" Background="{DynamicResource Brush_071A3B}" Foreground="{DynamicResource Brush_F2F6F8}" BorderBrush="{DynamicResource Brush_245B88}" Margin="0,8,0,8" DisplayMemberPath="Title" SelectionChanged="LibrarySong_SelectionChanged"/>
          <ScrollViewer Grid.Row="2" MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0"><StackPanel Grid.Row="2">
           <Button Content="＋ Adicionar vídeo atual a esta pasta" Click="AddCurrentVideoToFolder_Click"/>
           <Button Content="＋ Importar áudio MP3/WAV para uso offline" Click="ImportAudio_Click"/>
           <Expander Header="⬇ Download manual MP3/WAV" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="2,5,2,2" IsExpanded="False">
            <StackPanel Margin="3,4,3,3">
             <TextBox x:Name="LibraryDownloadUrlBox" ToolTip="Cole aqui um link direto para um arquivo MP3 ou WAV autorizado" MinHeight="32"/>
             <Grid Margin="2,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="LibraryDownloadFolderText" Text="Destino: pasta Musicas da Biblioteca Offline" Foreground="{DynamicResource TextMuted}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Button Grid.Column="1" Content="Escolher destino" Click="ChooseLibraryDownloadFolder_Click" MinHeight="27" Padding="7,2" FontSize="9"/>
             </Grid>
             <Button Content="⬇ Baixar link para esta coleção" Click="DownloadLibraryLink_Click" Background="{DynamicResource Brush_087F9E}" MinHeight="30" FontSize="10"/>
            </StackPanel>
           </Expander>
           <Button Content="✎ Editar música e letra selecionada" Click="EditLibrarySong_Click"/>
           <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⇄ Mover para outra pasta" Click="MoveLibrarySong_Click" Margin="2" FontSize="10"/>
            <Button Grid.Column="1" Content="− Remover desta pasta" Click="RemoveLibrarySong_Click" Margin="2" FontSize="10"/>
           </Grid>
           <Button Content="✨ Corrigir nomes de todas as músicas" Click="FixAllNames_Click" ToolTip="Separa intérprete e título e tira Playback, Legendado, um tom abaixo etc. em toda a biblioteca e no histórico"/>
          </StackPanel></ScrollViewer>
         </Grid>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Brush_0B2450}" BorderBrush="{DynamicResource Brush_00AFCB}" BorderThickness="1" CornerRadius="13" Padding="12">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="FAIXA DA BIBLIOTECA" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold" Margin="3,3,3,10"/>
          <Border Grid.Row="1" Background="{DynamicResource Brush_020A18}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="11" Padding="14">
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedItem.Title, ElementName=LibrarySongList}" Foreground="{DynamicResource Brush_FFFFFF}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Selecione uma faixa na lista para conferir o registro da biblioteca." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="4,12,4,0"/>
           </StackPanel>
          </Border>
          <TextBlock Grid.Row="2" Text="Organize as músicas por pastas e mantenha faixas disponíveis para reutilização e reprodução offline." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="4,8,4,2"/>
         </Grid>
        </Border>
       </Grid>
      </TabItem>
  </TabControl>
 </Grid>
 </TabItem>
</TabControl>
  <Image Source="pack://siteoforigin:,,,/Assets/Lyravoxen_Icone_App_1024.png" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0" Stretch="Uniform" Opacity="0.92" IsHitTestVisible="False">
   <Image.Effect><DropShadowEffect Color="{DynamicResource Color_13C8E4}" BlurRadius="18" ShadowDepth="0" Opacity="0.62"/></Image.Effect>
  </Image>
   <Border x:Name="OfflinePlaybackBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,8" Padding="8,5" Background="#E9081B36" BorderBrush="#00D9F5" BorderThickness="1" CornerRadius="14" Panel.ZIndex="20" Visibility="Collapsed">
   <DockPanel LastChildFill="True">
    <TextBlock x:Name="OfflinePlaybackTitle" DockPanel.Dock="Left" Text="Reprodução offline" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,12,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
    <Button Content="Ⅱ / ▶" Click="OfflinePlaybackToggle_Click" MinWidth="54" MinHeight="30" Padding="6,2"/>
    <Button Content="■" Click="OfflinePlaybackStop_Click" MinWidth="38" MinHeight="30" Padding="4,2"/>
    <TextBlock Text="Volume" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,2,0"/>
    <Slider x:Name="OfflineVolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="105" VerticalAlignment="Center" ValueChanged="OfflineVolumeSlider_Changed"/>
    <Slider x:Name="OfflinePositionSlider" Minimum="0" Maximum="100" Value="0" Width="190" Margin="8,0,4,0" VerticalAlignment="Center" ValueChanged="OfflinePositionSlider_Changed"/>
   </DockPanel>
  </Border>
  <Button x:Name="ThemeToggleButton" Content="☀" Width="42" Height="38" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,58,0" Click="ThemeToggle_Click" ToolTip="Alternar entre modo claro e modo escuro" Panel.ZIndex="10"/>
 </Grid>
</Window>