<Window x:Class="Lyravoxen.MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyravoxen" Height="860" Width="1440" MinHeight="600" MinWidth="900" WindowState="Maximized"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
 <Window.Resources>
  <Style TargetType="{x:Type Button}"><Setter Property="Foreground" Value="#EAF3F7"/><Setter Property="Background" Value="#243E50"/><Setter Property="BorderBrush" Value="#36566A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#31566A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#176E68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#0D151D"/><Setter Property="BorderBrush" Value="#355064"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}"><Border x:Name="T" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="1"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="BorderBrush" Value="#26C6B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type ComboBox}"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Grid Margin="8,10,8,8">
 <TabControl x:Name="WorkspaceTabs" Background="{StaticResource Bg}" BorderThickness="0" TabStripPlacement="Top">
  <TabControl.ItemContainerStyle><Style TargetType="{x:Type TabItem}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Background" Value="{StaticResource Panel}"/></Style></TabControl.ItemContainerStyle><TabItem Header="▶ Ao vivo"><Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0,4,14">
   <StackPanel><TextBlock Text="LYRAVOXEN" Foreground="{StaticResource Accent}" FontSize="25" FontWeight="Bold"/><TextBlock Text="Música em sintonia com palavras." Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="ESTÚDIO DE LETRAS  •  WINDOWS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="0,0,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="YoutubeUrlBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Cole aqui o link do YouTube"/>
    <Button x:Name="LoadYoutubeButton" Grid.Column="1" Content="Carregar YouTube" Click="LoadYoutube_Click"/>
    <Button Grid.Column="2" Content="Abrir projeção" Background="#176E68" Click="OpenProjection_Click"/>
    <Button x:Name="PlayNextButton" Grid.Column="3" Content="Tocar próxima" Click="PlayNextPrepared_Click" IsEnabled="False"/><Button Grid.Column="4" Content="Holyrics" Click="HolyricsSettings_Click"/><Button Grid.Column="5" Content="Testar projeção" Click="TestProjection_Click"/><Button Grid.Column="6" Content="Tela de espera" Click="ProjectionStandby_Click"/><Button Grid.Column="7" Content="Encerrar" Click="ProjectionEnding_Click"/><Button Grid.Column="8" Content="Diagnóstico" Click="RunDiagnostics_Click" ToolTip="Verificar a preparação para a apresentação"/><ComboBox x:Name="OutputDisplayBox" Grid.Column="9" Width="150" Margin="3" VerticalContentAlignment="Center" ToolTip="Escolha a tela onde as letras serão projetadas" SelectionChanged="OutputDisplay_SelectionChanged"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#080D12" CornerRadius="12" Padding="8" Margin="0,0,8,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="REPRODUÇÃO — PLAYER OFICIAL DO YOUTUBE" Foreground="{StaticResource TextMuted}" Margin="8"/>
     <wv2:WebView2 x:Name="YoutubePlayer" Grid.Row="1"/>
     <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="8,0,0,0">
    <TabControl Background="{StaticResource Panel}" BorderThickness="0">
     <TabItem Header="Sincronização">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="SINCRONIZAÇÃO DA LETRA" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,8"/>
       <TextBlock Grid.Row="1" Text="Informe o título e o intérprete. O nome do canal do YouTube não é necessariamente o artista. A letra só será carregada após sua confirmação." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,0,4,8"/>
       <Grid Grid.Row="2" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="MusicTrackBox" Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" ToolTip="Título da música"/>
        <TextBox x:Name="MusicArtistBox" Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" ToolTip="Nome do intérprete/artista"/>
        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Buscar letra sincronizada" Click="SearchLyrics_Click" Background="#176E68" Margin="0,4,0,0"/>
       </Grid>
       <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,0,4,6"><TextBlock Text="Linhas:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="LineCountBox" Width="58" SelectedIndex="3" SelectionChanged="LineCount_SelectionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox><TextBlock Text="Tema:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="ProjectionThemeBox" Width="125" SelectedIndex="0" SelectionChanged="ProjectionTheme_SelectionChanged"><ComboBoxItem Content="Noturno"/><ComboBoxItem Content="Clássico"/><ComboBoxItem Content="Âmbar"/></ComboBox></StackPanel>
       <Border Grid.Row="4" MaxHeight="108" Background="#0D151D" BorderBrush="#355064" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,2,4,5">
        <StackPanel>
         <TextBlock Text="PRÉVIA DO TELÃO" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
         <TextBlock x:Name="ProjectionPreviewText" Text="Aguardando uma frase sincronizada..." Foreground="#F2F6F8" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MinHeight="30" VerticalAlignment="Center"/>
         <TextBlock x:Name="NextProjectionPreviewText" Text="Próxima: —" Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
       </Border>
       <ListBox x:Name="CueList" Grid.Row="5" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="CueList_SelectionChanged" Margin="4"/>
       <UniformGrid Grid.Row="6" Columns="4" Margin="2,2,2,4">
        <Button Content="◀ Anterior" Click="PreviousCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Próxima ▶" Click="NextCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Projetar" Click="ProjectSelectedCue_Click" Background="#176E68" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Automático" Click="ResumeAutomaticProjection_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
       </UniformGrid>
       <UniformGrid Grid.Row="7" Columns="4" Margin="2,2,2,4">
        <Button Content="Editar" Click="EditCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Atualizar" Click="UpdateCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Excluir" Click="DeleteCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
        <Button Content="Reordenar" Click="MoveCue_Click" FontSize="10" Padding="4,3" Margin="1" MinHeight="26"/>
       </UniformGrid>
       <ScrollViewer Grid.Row="8" Margin="0,5,0,0" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="SecondsBox" Grid.Column="0" Text="0" ToolTip="Tempo em segundos"/>
         <TextBox x:Name="LyricTextBox" Grid.Column="1" ToolTip="Digite a frase da letra"/>
         <Button Grid.Column="2" Content="Adicionar tempo" Click="AddCue_Click"/>
        </Grid>
        <Button Content="Marcar frase no tempo atual" Click="MarkCueAtCurrentTime_Click" Background="#176E68"/>
        <TextBlock Text="Para antecipar a projeção, marque cerca de 1,5 segundo antes de a frase começar. O horário registrado não será alterado automaticamente." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="5,3"/>
        <Button Content="Importar letra sincronizada (.LRC / .SRT)" Click="ImportLyrics_Click" Margin="0,6,0,0"/>
       </StackPanel></ScrollViewer>
      </Grid>
     </TabItem>
     <TabItem Header="Histórico de vídeos">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="VÍDEOS UTILIZADOS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <TextBox x:Name="HistorySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar pelo título do vídeo" TextChanged="HistorySearch_TextChanged"/>
        <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar histórico" Click="HistorySearch_Click"/>
       </Grid>
       <ListBox x:Name="HistoryList" Grid.Row="2" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="4" SelectionChanged="HistoryList_SelectionChanged" DisplayMemberPath="Title"/>
       <TextBlock Grid.Row="3" Text="Selecione um título para carregar novamente o vídeo." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="6,8,4,2"/>
      </Grid>
     </TabItem>
     <TabItem Header="Biblioteca">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="MINHAS COLEÇÕES" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,8,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="LibraryFolderList" Grid.Row="0" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="LibraryFolder_SelectionChanged" DisplayMemberPath="Name"/>
         <Button Grid.Row="1" Content="＋ Criar pasta" Click="CreateFolder_Click" Margin="0,8,0,0"/>
         <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Renomear" Click="RenameFolder_Click"/>
          <Button Grid.Column="1" Content="Excluir" Click="DeleteFolder_Click"/>
         </Grid>
        </Grid>
        <Grid Grid.Column="1" Margin="8,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <TextBox x:Name="LibrarySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar nesta pasta" TextChanged="LibrarySearch_TextChanged"/>
          <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar músicas" Click="LibrarySearch_Click"/>
         </Grid>
         <ListBox x:Name="LibrarySongList" Grid.Row="1" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="0,8,0,8" DisplayMemberPath="Title" SelectionChanged="LibrarySong_SelectionChanged"/>
         <StackPanel Grid.Row="2"><Button Content="＋ Adicionar vídeo atual a esta pasta" Click="AddCurrentVideoToFolder_Click"/><Button Content="＋ Importar áudio MP3/WAV para uso offline" Click="ImportAudio_Click" Margin="0,5,0,0"/></StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="Pronto. Cole um link do YouTube para começar." Foreground="{StaticResource TextMuted}" Margin="6,12,0,0"/>
 </Grid></TabItem>
 <TabItem Header="＋ Próxima música">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="YoutubeSearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquise uma música ou cole um link do YouTube"/>
     <Button Grid.Column="1" Content="Pesquisar" Click="YoutubeSearch_Click"/>
     <Button Grid.Column="2" Content="Voltar" Click="YoutubeSearchBack_Click"/>
     <Button Grid.Column="3" Content="Avançar" Click="YoutubeSearchForward_Click"/>
     <Button Grid.Column="4" Content="Atualizar" Click="YoutubeSearchRefresh_Click"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6"><TextBlock Text="ABAS DO NAVEGADOR" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,12,0"/><Button Content="＋ Nova aba" Click="NewBrowserTab_Click" Padding="14,6"/><Button Content="Fechar aba" Click="CloseBrowserTab_Click" Padding="14,6" Margin="6,0,0,0"/></DockPanel><TabControl x:Name="BrowserTabs" Grid.Row="1" Background="#080D12" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged"><TabItem Header="YouTube 1"><wv2:WebView2 x:Name="YoutubeSearchView"/></TabItem></TabControl></Grid>
   <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="PRÓXIMA MÚSICA" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="NextTrackText" Text="Pesquise e abra o vídeo desejado. A música atual continuará tocando." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="1" Content="Preparar próxima" Click="PrepareNext_Click" Background="#176E68"/>
    </Grid>
   </Border>
  </Grid>
 </TabItem></TabControl>
 </Grid>
</Window>