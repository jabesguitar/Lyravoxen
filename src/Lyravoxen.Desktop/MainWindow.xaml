        </StackPanel>
        <Button x:Name="BibleVoiceConfirmButton" Grid.Column="1" Content="✔ Projetar (Enter)" Click="BibleVoiceConfirm_Click" Background="#087F9E" MinHeight="38" Padding="18,6" Margin="10,0,0,0"/>
        <Button Grid.Column="2" Content="✖ Descartar (Esc)" Click="BibleVoiceDiscard_Click" MinHeight="38" Padding="14,6" Margin="6,0,0,0"/>
       </Grid>
      </Border>
     </Grid>
    </Border>

    <Grid Grid.Row="2">
