         <TextBlock Text="PRÉVIA AO VIVO — O QUE ESTÁ SENDO PROJETADO" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold" Margin="5,5,5,9" TextWrapping="Wrap"/>
         <Border Grid.Row="1" Background="{DynamicResource Brush_020A18}" BorderBrush="{DynamicResource Brush_00AFCB}" BorderThickness="1.5" CornerRadius="14" Padding="18" MinHeight="290" ClipToBounds="True" VerticalAlignment="Stretch">
          <Grid>
           <Image Source="pack://siteoforigin:,,,/Assets/Lyravoxen_Icone_App_1024.png" Opacity="0.055" Stretch="Uniform" IsHitTestVisible="False"/>
