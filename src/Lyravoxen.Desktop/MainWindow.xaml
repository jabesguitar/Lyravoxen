<Window x:Class="Lyravoxen.MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyravoxen | Estúdio de Letras" Height="860" Width="1440" MinHeight="600" MinWidth="900" WindowState="Maximized" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
 <Window.Resources>
  <Style TargetType="{x:Type Button}"><Setter Property="Foreground" Value="#EAF3F7"/><Setter Property="Background" Value="#243E50"/><Setter Property="BorderBrush" Value="#36566A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#31566A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#176E68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#0D151D"/><Setter Property="BorderBrush" Value="#355064"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}"><Border x:Name="T" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="1"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="BorderBrush" Value="#26C6B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="#142330"/><Setter Property="Background" Value="#EAF1F5"/>
   <Setter Property="BorderBrush" Value="#527184"/><Setter Property="BorderThickness" Value="1.2"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Foreground" Value="#142330"/><Setter Property="Background" Value="#F4F7F9"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#D8E8EE"/><Setter Property="Foreground" Value="#102A38"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176E68"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#243E50"/>
   <Setter Property="BorderBrush" Value="#9BB5C4"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
    <Grid Background="Transparent" MinHeight="32">
     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CheckSurface" Grid.Column="0" Width="24" Height="24" CornerRadius="5" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="#07121A" VerticalAlignment="Center">
      <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#087F70"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#65F0D8"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#65F0D8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.75"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubTabItemStyle" TargetType="{x:Type TabItem}">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,7"/><Setter Property="Margin" Value="3,2,3,6"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#DCE8EF"/><Setter Property="Background" Value="#203746"/><Setter Property="BorderBrush" Value="#426276"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
    <Border x:Name="SubTabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="SubTabSurface" Property="Background" Value="#176E68"/><Setter TargetName="SubTabSurface" Property="BorderBrush" Value="#43D6C4"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SubTabSurface" Property="Background" Value="#31566A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ListBox}"><Setter Property="Background" Value="#0D151D"/><Setter Property="Foreground" Value="#EAF3F7"/><Setter Property="BorderBrush" Value="#2B4557"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="{x:Type ListBoxItem}"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="1"/><Setter Property="Foreground" Value="#EAF3F7"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1B4652"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#203746"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="8,10,8,8">
 <TabControl x:Name="WorkspaceTabs" Background="{StaticResource Bg}" BorderThickness="0" TabStripPlacement="Top">
  <TabControl.ItemContainerStyle><Style TargetType="{x:Type TabItem}">
  <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="3,2,3,5"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Background" Value="#1A2B38"/>
  <Setter Property="BorderBrush" Value="#304B5C"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
   <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#176E68"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#2BC7B5"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#29495A"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style></TabControl.ItemContainerStyle><TabItem Header="▶ Ao vivo"><Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0,4,10">
   <StackPanel><TextBlock Text="LYRAVOXEN" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="Bold"/><TextBlock Text="Música em sintonia com palavras." Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="ESTÚDIO DE LETRAS  •  WINDOWS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="7" Margin="0,0,0,10">
   <WrapPanel>
    <TextBox x:Name="YoutubeUrlBox" Width="280" VerticalContentAlignment="Center" ToolTip="Cole aqui o link do YouTube"/>
    <Button Content="Copiar link atual" Click="CopyCurrentVideoLink_Click" ToolTip="Copiar o endereço da música carregada"/>
    <Button x:Name="LoadYoutubeButton" Content="Carregar YouTube" Click="LoadYoutube_Click"/>
    <Button x:Name="PlayNextButton" Content="Tocar próxima" Click="PlayNextPrepared_Click" IsEnabled="False"/>
    <Button Content="Conectar Holyrics" Click="HolyricsSettings_Click" Background="#176E68" ToolTip="Configurar endereço, porta e token e testar a conexão com o Holyrics"/>
    <Button Content="Abrir projeção própria" Click="OpenLocalProjection_Click" ToolTip="Abrir a saída independente do Holyrics"/>
    <Button Content="Escolher fundo" Click="SelectProjectionBackground_Click" ToolTip="Importar um fundo JPG ou PNG para a projeção própria"/>
    <CheckBox x:Name="HolyricsEnabledBox" Content="Holyrics ativo" IsChecked="True" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0" Checked="HolyricsEnabled_Changed" Unchecked="HolyricsEnabled_Changed" ToolTip="Desativar interrompe o envio e fecha a apresentação rápida, sem encerrar o Holyrics"/>
    <Button Content="Sair da projeção" Click="ExitProjection_Click" Background="#8C3B3B" ToolTip="Fechar a projeção local, a apresentação rápida e a apresentação atual do Holyrics"/>
    <Button Content="Encerrar música" Click="EndPlaybackManually_Click" Background="#8C3B3B" ToolTip="Parar a música e fechar a projeção no Lyravoxen e no Holyrics"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="1.22*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#080D12" CornerRadius="12" Padding="8" Margin="0,0,8,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="REPRODUÇÃO — PLAYER OFICIAL DO YOUTUBE" Foreground="{StaticResource TextMuted}" Margin="8"/>
     <wv2:WebView2 x:Name="YoutubePlayer" Grid.Row="1"/>
     <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="8,0,0,0">
    <TabControl x:Name="SyncTabs" Background="{StaticResource Panel}" BorderThickness="0">
     <TabItem Header="Sincronização">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="SINCRONIZAÇÃO DA LETRA" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,8"/>
       <TextBlock Grid.Row="1" Text="Informe autor/compositor, intérprete e título da música. Esses dados ficam salvos no histórico e vinculados ao vídeo do YouTube para reutilização posterior." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,0,4,8"/>
       <Grid Grid.Row="2" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
          <TextBlock Text="Autor / Compositor" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,2"/>
          <TextBox x:Name="MusicComposerBox" ToolTip="Nome do autor ou compositor" LostFocus="MusicMetadata_LostFocus"/>
         </StackPanel>
         <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
          <TextBlock Text="Intérprete" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,2"/>
          <TextBox x:Name="MusicArtistBox" ToolTip="Nome do intérprete" LostFocus="MusicMetadata_LostFocus"/>
         </StackPanel>
         <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
          <TextBlock Text="Título da música" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,2"/>
          <TextBox x:Name="MusicTrackBox" ToolTip="Título da música" LostFocus="MusicMetadata_LostFocus"/>
         </StackPanel>
         <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Buscar letra" Click="SearchLyrics_Click" Background="#176E68" Margin="0,4,0,0"/>

        </Grid>
       <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,0,4,8"><TextBlock Text="Linhas:" Foreground="#F2F6F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="LineCountBox" Width="64" SelectedIndex="3" SelectionChanged="LineCount_SelectionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox><TextBlock Text="A aparência do telão é controlada pelo Holyrics." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,5,0"/></StackPanel>
       <Border Grid.Row="4" Background="#132533" BorderBrush="#3D657A" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="4,2,4,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="PRÉVIA DO TELÃO — FORMATO 16:9" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" Margin="2,0,2,8"/>
         <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxHeight="560">
          <Border Width="960" Height="540" Background="#080D12" BorderBrush="#6B8798" BorderThickness="2" CornerRadius="8" Padding="48" MinWidth="640">
           <TextBlock x:Name="ProjectionPreviewText" Text="Aguardando uma frase sincronizada..." Foreground="#F2F6F8" FontSize="48" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
         </Viewbox>
         <TextBlock x:Name="NextProjectionPreviewText" Grid.Row="2" Text="Próxima: —" Foreground="#B8CAD5" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
       </Border>
      </Grid>
     </TabItem>
     <TabItem x:Name="ManualControlsTab" Header="Controles manuais">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ListBox x:Name="CueList" Grid.Row="0" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="CueList_SelectionChanged" Margin="4"/>
       <UniformGrid Grid.Row="1" Columns="4" Margin="2,2,2,4">
        <Button Content="◀ Anterior" Click="PreviousCue_Click"/>
        <Button Content="Próxima ▶" Click="NextCue_Click"/>
        <Button Content="Projetar selecionada" Click="ProjectSelectedCue_Click" Background="#176E68"/>
        <Button Content="Modo automático" Click="ResumeAutomaticProjection_Click"/>
       </UniformGrid>
       <UniformGrid Grid.Row="2" Columns="4" Margin="2,2,2,4">
        <Button Content="Editar selecionada" Click="EditCue_Click"/>
        <Button Content="Atualizar frase" Click="UpdateCue_Click"/>
        <Button Content="Excluir frase" Click="DeleteCue_Click"/>
        <Button Content="↑ / ↓ Reordenar" Click="MoveCue_Click"/>
       </UniformGrid>
       <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="SecondsBox" Grid.Column="0" Text="0" ToolTip="Tempo em segundos"/>
         <TextBox x:Name="LyricTextBox" Grid.Column="1" ToolTip="Digite a frase da letra"/>
         <Button Grid.Column="2" Content="Adicionar tempo" Click="AddCue_Click"/>
        </Grid>
        <Button Content="Marcar frase no tempo atual" Click="MarkCueAtCurrentTime_Click" Background="#176E68"/>
        <TextBlock Text="Para antecipar a projeção, marque cerca de 1,5 segundo antes de a frase começar. O horário registrado não será alterado automaticamente." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="5,3"/>
        <Button Content="Importar letra sincronizada (.LRC / .SRT)" Click="ImportLyrics_Click" Margin="0,6,0,0"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="Histórico de vídeos">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="VÍDEOS UTILIZADOS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <TextBox x:Name="HistorySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar pelo título do vídeo" TextChanged="HistorySearch_TextChanged"/>
        <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar histórico" Click="HistorySearch_Click"/>
       </Grid>
       <ListBox x:Name="HistoryList" Grid.Row="2" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="4" SelectionChanged="HistoryList_SelectionChanged" DisplayMemberPath="Title"/>
       <TextBlock Grid.Row="3" Text="Selecione um título para carregar novamente o vídeo." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="6,8,4,2"/>
      </Grid>
     </TabItem>
     <TabItem Header="Biblioteca">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="MINHAS COLEÇÕES" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,8,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="LibraryFolderList" Grid.Row="0" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" SelectionChanged="LibraryFolder_SelectionChanged" DisplayMemberPath="Name"/>
         <Button Grid.Row="1" Content="＋ Criar pasta" Click="CreateFolder_Click" Margin="0,8,0,0"/>
         <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Renomear" Click="RenameFolder_Click"/>
          <Button Grid.Column="1" Content="Excluir" Click="DeleteFolder_Click"/>
         </Grid>
        </Grid>
        <Grid Grid.Column="1" Margin="8,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <TextBox x:Name="LibrarySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar nesta pasta" TextChanged="LibrarySearch_TextChanged"/>
          <Button Grid.Column="1" Content="⌕" FontSize="22" Padding="2" ToolTip="Pesquisar músicas" Click="LibrarySearch_Click"/>
         </Grid>
         <ListBox x:Name="LibrarySongList" Grid.Row="1" Background="#0D151D" Foreground="#F2F6F8" BorderBrush="#355064" Margin="0,8,0,8" DisplayMemberPath="Title" SelectionChanged="LibrarySong_SelectionChanged"/>
         <StackPanel Grid.Row="2"><Button Content="＋ Adicionar vídeo atual a esta pasta" Click="AddCurrentVideoToFolder_Click"/><Button Content="＋ Importar áudio MP3/WAV para uso offline" Click="ImportAudio_Click" Margin="0,5,0,0"/></StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </TabItem>
</TabControl>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="Pronto. Cole um link do YouTube para começar." Foreground="{StaticResource TextMuted}" Margin="6,12,0,0"/>
 </Grid></TabItem>
 <TabItem x:Name="ManualSyncTab" Header="Cadastrar letra">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="0,0,0,12">
    <TextBlock Text="CADASTRAR LETRA PARA ESTA MÚSICA" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold"/>
    <TextBlock Text="Quando a busca automática não encontrar a letra, procure nas fontes alternativas, copie a letra completa e cole aqui. Salve uma vez. Com a música tocando, o Lyravoxen compara o áudio com a letra salva e envia os trechos reconhecidos ao Holyrics." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
   <TextBox x:Name="ManualLyricsBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" Padding="14" VerticalContentAlignment="Top" ToolTip="Letra completa: mantenha cada frase em uma linha. As estrofes em branco podem separar partes da música."/>
   <Grid Grid.Row="2" Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="Salvar letra completa" Click="SaveFullLyrics_Click" Background="#176E68" Height="42" FontSize="14" Padding="18,8"/>
    <Button x:Name="AutoRecognitionButton" Grid.Column="1" Content="Iniciar reconhecimento automático" Click="ToggleAutoRecognition_Click" Background="#176E68" Height="42" FontSize="14" Padding="18,8"/>
    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock x:Name="ManualSyncProgressText" Text="Salve a letra completa. Ao iniciar a música, ative o reconhecimento automático." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
     <TextBlock x:Name="ManualCurrentLineText" Text="Aguardando o reconhecimento da música..." Foreground="#F2F6F8" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
 </TabItem>
 <TabItem Header="＋ Próxima música">
  <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="YoutubeSearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquise uma música ou cole um link do YouTube"/>
     <Button Grid.Column="1" Content="Pesquisar" Click="YoutubeSearch_Click"/>
     <Button Grid.Column="2" Content="Voltar" Click="YoutubeSearchBack_Click"/>
     <Button Grid.Column="3" Content="Avançar" Click="YoutubeSearchForward_Click"/>
     <Button Grid.Column="4" Content="Atualizar" Click="YoutubeSearchRefresh_Click"/>
     <Button Grid.Column="5" Content="Copiar link" Click="CopyBrowserLink_Click" ToolTip="Copiar o endereço da página aberta nesta aba"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6"><TextBlock Text="PESQUISA E FONTES DE LETRAS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,12,0"/><Button Content="＋ Nova aba" Click="NewBrowserTab_Click" Padding="14,6"/><Button Content="Fechar aba" Click="CloseBrowserTab_Click" Padding="14,6" Margin="6,0,0,0"/></DockPanel><WrapPanel Grid.Row="1" Margin="2,0,2,8"><Button Content="▶ YouTube" Tag="youtube" Click="OpenQuickSite_Click"/><Button Content="G Google" Tag="google" Click="OpenQuickSite_Click"/><Button Content="♫ Cifra Club" Tag="cifraclub" Click="OpenQuickSite_Click"/><Button Content="V Vagalume" Tag="vagalume" Click="OpenQuickSite_Click"/><Button Content="L Letras.mus.br" Tag="letras" Click="OpenQuickSite_Click"/><Button Content="♪ Ouvir Música" Tag="ouvir" Click="OpenQuickSite_Click"/><Button Content="✝ Harpa Cristã" Tag="harpa" Click="OpenQuickSite_Click"/></WrapPanel><TabControl x:Name="BrowserTabs" Grid.Row="2" Background="#080D12" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged"><TabItem Header="YouTube 1"><wv2:WebView2 x:Name="YoutubeSearchView"/></TabItem></TabControl></Grid>
   <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="10" Margin="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="PRÓXIMA MÚSICA" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="NextTrackText" Text="Pesquise e abra o vídeo desejado. A música atual continuará tocando." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="1" Content="Preparar próxima" Click="PrepareNext_Click" Background="#176E68"/>
    </Grid>
   </Border>
  </Grid>
 </TabItem> <TabItem Header="✦ Bíblia" x:Name="BibleWorkspaceTab">
  <Grid Margin="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="4,0,4,12">
    <TextBlock Text="CENTRAL BÍBLICA" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold"/>
    <TextBlock Text="Consulta, leitura, reconhecimento por microfone e projeção — em uma área exclusiva." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
   </StackPanel>
   <TabControl Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="0" ItemContainerStyle="{StaticResource SubTabItemStyle}">
         <TabItem Header="Bíblia e microfone">
      <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="RECONHECIMENTO DE FALA PARA REFERÊNCIAS BÍBLICAS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" Margin="4,4,4,10"/>
       <WrapPanel Grid.Row="1" Margin="4" VerticalAlignment="Center">
        <StackPanel Margin="2,0,6,2"><TextBlock Text="DISPOSITIVO DE ENTRADA" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,2"/><ComboBox x:Name="BibleMicrophoneBox" Width="360" SelectionChanged="BibleMicrophone_SelectionChanged" ToolTip="Selecione o microfone que será usado"/></StackPanel>
        <StackPanel Margin="2,0,6,2" VerticalAlignment="Bottom"><TextBlock Text=" " FontSize="10"/><Button x:Name="RefreshMicrophonesButton" Content="Atualizar dispositivos" Click="RefreshMicrophones_Click" MinHeight="38"/></StackPanel>
        <Border Background="#243E50" BorderBrush="#527184" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="4,14,2,2" VerticalAlignment="Bottom">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="BibleMicrophoneEnabledBox" Content="MICROFONE ATIVO" Foreground="#FFFFFF" VerticalAlignment="Center" Checked="BibleMicrophoneEnabled_Changed" Unchecked="BibleMicrophoneEnabled_Changed" IsThreeState="False" MinWidth="180" ToolTip="Marque para iniciar o reconhecimento de referências bíblicas"/>
          <TextBlock x:Name="BibleMicrophoneToggleStateText" Text="DESLIGADO" Foreground="#FFD28A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,2,0"/>
          <StackPanel VerticalAlignment="Center" Margin="8,0,4,0"><TextBlock Text="NÍVEL DE ÁUDIO" Foreground="{StaticResource TextMuted}" FontSize="9"/><ProgressBar x:Name="BibleMicrophoneLevelBar" Width="150" Height="12" Minimum="0" Maximum="100" Value="0" Background="#0D151D" Foreground="#24B89E"/><TextBlock x:Name="BibleMicrophoneLevelText" Text="Sem sinal de áudio" Foreground="{StaticResource TextMuted}" FontSize="9"/></StackPanel>
         </StackPanel>
        </Border>
       </WrapPanel>
       <Border Grid.Row="2" Background="#132533" BorderBrush="#355064" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,5">
        <StackPanel><TextBlock Text="ESTADO DO MICROFONE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BibleMicrophoneStatusText" Text="Microfone desligado. Selecione o dispositivo e marque MICROFONE ATIVO. O primeiro uso precisa baixar o modelo gratuito de voz; aguarde a confirmação de que está ouvindo." Foreground="#EAF3F7" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
       </Border>
       <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="TRANSCRIÇÃO RECONHECIDA — CONFIRA A REFERÊNCIA ANTES DE PROJETAR" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="4"/>
        <TextBox x:Name="BibleTranscriptBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" Padding="10" Background="#F3F7FA" Foreground="#142B39" BorderBrush="#54788C" BorderThickness="1.5" ToolTip="A transcrição de voz aparecerá aqui. A projeção de versículos exige confirmação do operador."/>
       </Grid>
      </Grid>
     </TabItem>
     <TabItem Header="Bíblia">
      <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="BIBLIOTECA BÍBLICA — CONSULTA E PROJEÇÃO" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" Margin="4,4,4,8"/>
       <StackPanel Grid.Row="1" Margin="2">
        <TextBlock Text="ALMEIDA REVISTA E CORRIGIDA — SBB 2009" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="12" Margin="2,4"/>
        <WrapPanel>
         <ComboBox x:Name="BibleHolyricsArcVersionBox" Width="320" IsEditable="False" ToolTip="Versões ARC instaladas no Holyrics">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="#142330" FontSize="13"/></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox>
         <Button Content="Buscar versões no Holyrics" Click="RefreshHolyricsBibleVersions_Click"/>
         <TextBox x:Name="BibleHolyricsReferenceBox" Width="160" Text="João 3:16" ToolTip="Digite uma referência, por exemplo João 3:16 ou Salmos 23:1"/>
         <Button Content="Projetar referência ARC" Click="ProjectHolyricsBibleReference_Click" Background="#176E68"/>
        </WrapPanel>
        <TextBlock x:Name="BibleHolyricsVersionStatusText" Text="Conecte o Holyrics e clique em Buscar versões para preencher esta lista." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="3,3,3,5"/>
        <TextBlock Text="A Bíblia precisa estar instalada e licenciada no Holyrics." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="3,4,3,8"/>
        <TextBlock Text="CONSULTA BÍBLICA LOCAL" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11" Margin="2,4"/>
        <WrapPanel VerticalAlignment="Center">
         <StackPanel Margin="2,0,5,2"><TextBlock Text="1. Bíblia / versão" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,1"/><ComboBox x:Name="BibleVersionReaderBox" Width="350" ToolTip="Selecione a versão bíblica">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#142330" FontSize="13"/></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox></StackPanel>
         <StackPanel Margin="2,0,5,2"><TextBlock Text="2. Livro" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,1"/><ComboBox x:Name="BibleBookReaderBox" Width="205" SelectionChanged="BibleBookReader_SelectionChanged" ToolTip="Selecione o livro bíblico">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#142330" FontSize="13"/></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox></StackPanel>
         <StackPanel Margin="2,0,5,2"><TextBlock Text="3. Capítulo" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,1"/><ComboBox x:Name="BibleChapterReaderBox" Width="90" SelectionChanged="BibleChapterReader_SelectionChanged" ToolTip="Selecione o capítulo"/></StackPanel>
         <StackPanel Margin="2,0,5,2"><TextBlock Text="4. Versículo" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,1"/><ComboBox x:Name="BibleVerseReaderBox" Width="110" SelectionChanged="BibleVerseReader_SelectionChanged" ToolTip="Selecione o versículo para projetar">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="#142330" FontSize="13"/></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox></StackPanel>
         <StackPanel Margin="2,0,5,2"><TextBlock Text="Leitura" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="3,0,0,1"/><ComboBox x:Name="BibleChapterCountBox" Width="105" SelectedIndex="0" ToolTip="Quantidade de capítulos consecutivos"><ComboBoxItem Content="1 capítulo"/><ComboBoxItem Content="2 capítulos"/><ComboBoxItem Content="3 capítulos"/><ComboBoxItem Content="4 capítulos"/><ComboBoxItem Content="5 capítulos"/><ComboBoxItem Content="6 capítulos"/></ComboBox></StackPanel>
         <StackPanel VerticalAlignment="Bottom" Margin="2,0,2,2"><TextBlock Text=" " FontSize="10"/><Button Content="Carregar leitura" Click="LoadBibleChapter_Click" Background="#176E68" MinHeight="38"/></StackPanel>
        </WrapPanel>
       </StackPanel>
       <ListBox x:Name="BibleVersesList" Grid.Row="2" Margin="4" MinHeight="280" Background="#F3F7FA" Foreground="#142B39" BorderBrush="#54788C" BorderThickness="1.5" FontSize="15" Padding="8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="BibleVerse_DoubleClick" SelectionChanged="BibleVersesList_SelectionChanged">
        <ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}">
         <Setter Property="Foreground" Value="#142B39"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176E68"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D8E8EE"/></Trigger></Style.Triggers>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="#142B39" FontSize="15" TextWrapping="Wrap" Padding="2"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel Grid.Row="3">
        <TextBlock x:Name="BibleCopyrightText" Text="As traduções disponíveis exibem sua licença e atribuição. Capítulos consultados ficam armazenados para uso offline." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="10" Margin="5"/>
        <TextBlock Text="Selecione o livro, capítulo e versículo acima ou toque em um versículo da lista." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="5,2"/>
        <Button Content="Projetar versículo selecionado no telão" Click="ProjectBibleVerse_Click" Background="#176E68" MinHeight="44"/>
       </StackPanel>
      </Grid>
     </TabItem>

   </TabControl>
  </Grid>
 </TabItem>
</TabControl>
 </Grid>
</Window>