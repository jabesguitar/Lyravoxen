       <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
      </Grid>
     </Border>
     <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="14" Padding="8" Margin="0" MinHeight="390">
<TabControl x:Name="SyncTabs" Background="{DynamicResource Panel}" BorderThickness="0" MinHeight="370">
      <TabItem Header="Sincronização">
       <Grid Margin="4" MinHeight="340">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.36*"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
