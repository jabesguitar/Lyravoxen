<Window x:Class="Lyravoxen.MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown" PreviewKeyUp="MainWindow_PreviewKeyUp" PreviewTextInput="MainWindow_PreviewTextInput"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyravoxen | Estúdio de Letras" Height="860" Width="1440" MinHeight="600" MinWidth="900" WindowState="Maximized" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}">
 <Window.Resources>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/>
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource Color_174A78}" Offset="0"/><GradientStop Color="{DynamicResource Color_0D2A50}" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_267DA8}"/>
   <Setter Property="BorderThickness" Value="1.2"/>
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type Button}">
     <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#00E5FF"/><Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="13" ShadowDepth="0" Opacity="0.28"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#087F9E"/><Setter TargetName="B" Property="BorderBrush" Value="#6CF2FF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/><Setter Property="Background" Value="{DynamicResource Brush_071A3B}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_245B88}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}">
    <Border x:Name="T" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ScrollViewer x:Name="PART_ContentHost" Margin="1"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="T" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="10" ShadowDepth="0" Opacity="0.20"/></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/><Setter Property="Background" Value="{DynamicResource Brush_071A3B}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_245B88}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}">
     <Grid>
      <Border x:Name="ComboSurface" Background="{DynamicResource Brush_071A3B}" BorderBrush="{DynamicResource Brush_245B88}" BorderThickness="1" CornerRadius="10">
       <Grid>
        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,34,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Width="30">
         <TextBlock Text="⌄" Foreground="{DynamicResource Brush_00D9F5}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </ToggleButton>
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
       <Border Background="{DynamicResource Brush_0B2450}" BorderBrush="{DynamicResource Brush_00D9F5}" BorderThickness="1" CornerRadius="10" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="ComboSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="9" ShadowDepth="0" Opacity="0.18"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/><Setter Property="Background" Value="{DynamicResource Brush_0B2450}"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Brush_123A66}"/><Setter Property="Foreground" Value="{DynamicResource Brush_00D9F5}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Brush_087F9E}"/><Setter Property="Foreground" Value="{DynamicResource Brush_FFFFFF}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/><Setter Property="Background" Value="{DynamicResource Brush_123A66}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_6B9DBA}"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
    <Grid Background="Transparent" MinHeight="32">
     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CheckSurface" Grid.Column="0" Width="24" Height="24" CornerRadius="7" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="{DynamicResource Brush_071A3B}" VerticalAlignment="Center">
      <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="17" FontWeight="Black" Foreground="{DynamicResource Brush_FFFFFF}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#087F9E"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#00D9F5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubTabItemStyle" TargetType="{x:Type TabItem}">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,7"/><Setter Property="Margin" Value="3,2,3,6"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush_DCEBFA}"/><Setter Property="Background" Value="{DynamicResource Brush_102D52}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush_245B88}"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="Margin" Value="3,2,3,6"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush_C7DDF2}"/>
   <Setter Property="Background" Value="{DynamicResource Brush_102D52}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_245B88}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="SubTabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="SubTabBorder" Property="Background" Value="#0B5478"/>
       <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#00D9F5"/>
       <Setter TargetName="SubTabBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/></Setter.Value></Setter>
       <Setter Property="Foreground" Value="{DynamicResource Brush_FFFFFF}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#38CDEB"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type ListBox}">
   <Setter Property="Background" Value="{DynamicResource Brush_071A3B}"/><Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush_245B88}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush_EAF3FF}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#173D68"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38DDF5"/></Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="ItemBorder" Property="Background" Value="#087F9E"/>
      <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00E5FF"/>
      <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter TargetName="ItemBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="12" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="12,8,12,10">
  <Image Source="pack://siteoforigin:,,,/Assets/Lyravoxen_Icone_App_1024.png" Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,35" Stretch="Uniform" Opacity="0.045" IsHitTestVisible="False"/>
 <TabControl x:Name="WorkspaceTabs" Background="{DynamicResource Bg}" BorderThickness="0" TabStripPlacement="Top">
  <TabControl.ItemContainerStyle><Style TargetType="{x:Type TabItem}">
  <Setter Property="MinHeight" Value="52"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,3,4,8"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="{DynamicResource Brush_F2F6F8}"/>
  <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource Color_174A78}" Offset="0"/><GradientStop Color="{DynamicResource Color_0D2A50}" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush_267DA8}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
   <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="27" Padding="{TemplateBinding Padding}">
    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush_00D9F5}"/><Setter TargetName="TabBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="13" ShadowDepth="0" Opacity="0.28"/></Setter.Value></Setter></Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter TargetName="TabBorder" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource Color_00D9F5}" Offset="0"/><GradientStop Color="{DynamicResource Color_087F9E}" Offset="0.55"/><GradientStop Color="{DynamicResource Color_1764C7}" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
     <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
     <Setter TargetName="TabBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource Color_00D9F5}" BlurRadius="18" ShadowDepth="0" Opacity="0.42"/></Setter.Value></Setter>
     <Setter Property="Foreground" Value="{DynamicResource Brush_FFFFFF}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style></TabControl.ItemContainerStyle><TabItem><TabItem.Header>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="29" Height="29" CornerRadius="15" Background="{DynamicResource Brush_0BAFC4}" BorderBrush="{DynamicResource Brush_FFFFFF}" BorderThickness="1.5" Margin="0,0,8,0">
      <TextBlock Text="▶" Foreground="{DynamicResource Brush_FFFFFF}" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="Ao vivo" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
    </StackPanel>
   </TabItem.Header>
   <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="4,0,4,8">
     <StackPanel><TextBlock Text="PAINEL AO VIVO" Foreground="{DynamicResource Accent}" FontSize="18" FontWeight="Bold"/><TextBlock Text="Reprodução, sincronização e projeção" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
     <TextBlock DockPanel.Dock="Right" Text="ESTÚDIO DE LETRAS  •  WINDOWS" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="14" Padding="8" Margin="0,0,0,8">
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="MÚSICA" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="5,0,3,0" VerticalAlignment="Center"/>
      <TextBox x:Name="YoutubeUrlBox" Width="225" MinHeight="38" VerticalContentAlignment="Center" ToolTip="Cole aqui o link do YouTube" TextChanged="YoutubeUrlBox_TextChanged"/>
      <Button x:Name="LoadYoutubeButton" Content="▶ Carregar YouTube" Click="LoadYoutube_Click" Background="{DynamicResource Brush_087F9E}"/>
      <Button x:Name="PlayNextButton" Content="Tocar próxima" Click="PlayNextPrepared_Click" IsEnabled="False"/>
      <TextBlock Text="INTEGRAÇÃO" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="9,0,3,0" VerticalAlignment="Center"/>
      <Button Content="Conectar Holyrics" Click="HolyricsSettings_Click" Background="{DynamicResource Brush_087F9E}" ToolTip="Configurar endereço, porta e token e testar a conexão com o Holyrics"/>
      <CheckBox x:Name="HolyricsEnabledBox" Content="Holyrics ativo" IsChecked="True" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,5,4,5" Checked="HolyricsEnabled_Changed" Unchecked="HolyricsEnabled_Changed" ToolTip="Desativar interrompe o envio e fecha a apresentação rápida, sem encerrar o Holyrics"/>
      <Button Content="📱 Controle pelo celular" Click="Remote_Click" ToolTip="Controlar a aba Bíblia pelo celular (QR code e PIN)"/>
      <TextBlock Text="PROJEÇÃO" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="9,0,3,0" VerticalAlignment="Center"/>
      <Button x:Name="LocalProjectionToggleButton" Content="Abrir projeção própria" Click="OpenLocalProjection_Click" ToolTip="Abrir ou fechar a tela independente de projeção"/>
      <Button Content="Escolher fundo" Click="SelectProjectionBackground_Click" ToolTip="Importar um fundo JPG ou PNG para a projeção própria"/>
      <Button Content="Sair da projeção" Click="ExitProjection_Click" Background="{DynamicResource Brush_8C3B3B}" ToolTip="Fechar a projeção própria e a apresentação atual do Holyrics"/>
      <Button Content="Encerrar música" Click="EndPlaybackManually_Click" Background="{DynamicResource Brush_8C3B3B}" ToolTip="Parar a música e fechar a projeção no Lyravoxen e no Holyrics"/>
      <TextBlock Text="FERRAMENTAS" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="9,0,3,0" VerticalAlignment="Center"/>
      <Button Content="🩺 Diagnóstico" Click="Diagnostics_Click" ToolTip="Confere Holyrics, permissões, microfone, monitores e internet"/>
      <Button Content="☁ Backup" Click="Backup_Click" ToolTip="Backup da biblioteca em uma pasta (OneDrive, Google Drive, pendrive) e restauração"/>
      <Button x:Name="RequestsButton" Content="📥 Pedidos (0)" Click="Requests_Click" ToolTip="Músicas enviadas pelas pessoas pelo link de pedidos"/>
      <Button x:Name="PinTopButton" Content="📌 Fixar à frente" Click="PinTop_Click" ToolTip="Mantém o Lyravoxen sempre à frente (útil contra a janela Apresentação Rápida do Holyrics)"/>
      <Button Content="📋 Relatório" Click="Report_Click" ToolTip="Copia o relatório de uso e erros para colar na conversa"/>
      <TextBlock x:Name="UrlLyricsHintText" Width="230" Foreground="{DynamicResource Brush_B8CAD5}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="6,3" VerticalAlignment="Center"/>
     </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="1.22*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{DynamicResource Brush_07172C}" CornerRadius="14" Padding="8" Margin="0,0,8,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="REPRODUÇÃO — YOUTUBE" Foreground="{DynamicResource TextMuted}" Margin="8" FontWeight="Bold" FontSize="11"/>
       <wv2:WebView2 x:Name="YoutubePlayer" Grid.Row="1" MinHeight="220"/>
       <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
      </Grid>
     </Border>
     <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="14" Padding="8" Margin="0" MinHeight="390">
<TabControl x:Name="SyncTabs" Background="{DynamicResource Panel}" BorderThickness="0" MinHeight="370">
