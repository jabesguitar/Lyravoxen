<Window x:Class="Lyravoxen.MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown" PreviewKeyUp="MainWindow_PreviewKeyUp" PreviewTextInput="MainWindow_PreviewTextInput"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyravoxen | Estúdio de Letras" Height="860" Width="1440" MinHeight="600" MinWidth="900" WindowState="Maximized" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
 <Window.Resources>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#174A78" Offset="0"/><GradientStop Color="#0D2A50" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="#267DA8"/>
   <Setter Property="BorderThickness" Value="1.2"/>
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type Button}">
     <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#00E5FF"/><Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="13" ShadowDepth="0" Opacity="0.28"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#087F9E"/><Setter TargetName="B" Property="BorderBrush" Value="#6CF2FF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#071A3B"/>
   <Setter Property="BorderBrush" Value="#245B88"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}">
    <Border x:Name="T" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ScrollViewer x:Name="PART_ContentHost" Margin="1"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="T" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="10" ShadowDepth="0" Opacity="0.20"/></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#071A3B"/>
   <Setter Property="BorderBrush" Value="#245B88"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}">
     <Grid>
      <Border x:Name="ComboSurface" Background="#071A3B" BorderBrush="#245B88" BorderThickness="1" CornerRadius="10">
       <Grid>
        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,34,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Width="30">
         <TextBlock Text="⌄" Foreground="#00D9F5" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </ToggleButton>
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
       <Border Background="#0B2450" BorderBrush="#00D9F5" BorderThickness="1" CornerRadius="10" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="ComboSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="9" ShadowDepth="0" Opacity="0.18"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#0B2450"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#123A66"/><Setter Property="Foreground" Value="#00D9F5"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#087F9E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="#F2F6F8"/><Setter Property="Background" Value="#123A66"/>
   <Setter Property="BorderBrush" Value="#6B9DBA"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
    <Grid Background="Transparent" MinHeight="32">
     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CheckSurface" Grid.Column="0" Width="24" Height="24" CornerRadius="7" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="#071A3B" VerticalAlignment="Center">
      <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#087F9E"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#00D9F5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubTabItemStyle" TargetType="{x:Type TabItem}">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,7"/><Setter Property="Margin" Value="3,2,3,6"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#DCEBFA"/><Setter Property="Background" Value="#102D52"/><Setter Property="BorderBrush" Value="#245B88"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="Margin" Value="3,2,3,6"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#C7DDF2"/>
   <Setter Property="Background" Value="#102D52"/>
   <Setter Property="BorderBrush" Value="#245B88"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="SubTabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="SubTabBorder" Property="Background" Value="#0B5478"/>
       <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#00D9F5"/>
       <Setter TargetName="SubTabBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/></Setter.Value></Setter>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#38CDEB"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type ListBox}">
   <Setter Property="Background" Value="#071A3B"/><Setter Property="Foreground" Value="#F2F6F8"/>
   <Setter Property="BorderBrush" Value="#245B88"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Foreground" Value="#EAF3FF"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#123A66"/><Setter Property="Foreground" Value="#00D9F5"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00D9F5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="12,10,12,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0B2450" BorderBrush="#00AFCB" BorderThickness="1" CornerRadius="18" Padding="10,7" Margin="0,0,0,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="48" Height="48" CornerRadius="13" Background="#06152F" BorderBrush="#00D9F5" BorderThickness="1">
     <Image Source="pack://siteoforigin:,,,/Assets/Lyravoxen_Icone_App_1024.png" Stretch="Uniform" Margin="2"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
     <TextBlock Text="Lyravoxen" Foreground="#F2F6F8" FontSize="20" FontWeight="Bold"/>
     <TextBlock Text="ESTÚDIO DE LETRAS  ·  LETRAS PARA O SEU LOUVOR" Foreground="#B5C8E7" FontSize="9" FontWeight="SemiBold"/>
    </StackPanel>
    <Border Grid.Column="2" CornerRadius="10" BorderBrush="#245B88" BorderThickness="1" Padding="11,6" VerticalAlignment="Center">
     <TextBlock Text="WINDOWS" Foreground="#00D9F5" FontSize="10" FontWeight="Bold"/>
    </Border>
   </Grid>
  </Border>
 <TabControl Grid.Row="1" x:Name="WorkspaceTabs" Background="{StaticResource Bg}" BorderThickness="0" TabStripPlacement="Top">
  <TabControl.ItemContainerStyle><Style TargetType="{x:Type TabItem}">
  <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="3,2,3,5"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Background" Value="#1A2B38"/>
  <Setter Property="BorderBrush" Value="#304B5C"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
   <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#0B6488"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#00D9F5"/><Setter TargetName="TabBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="#00D9F5" BlurRadius="13" ShadowDepth="0" Opacity="0.24"/></Setter.Value></Setter><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#29495A"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style></TabControl.ItemContainerStyle><TabItem Header="▶ Ao vivo"><Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0,4,10">
   <StackPanel><TextBlock Text="PAINEL AO VIVO" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold"/><TextBlock Text="Reprodução, sincronização e projeção" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="ESTÚDIO DE LETRAS  •  WINDOWS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="7" Margin="0,0,0,10">
   <StackPanel><WrapPanel>
    <TextBox x:Name="YoutubeUrlBox" Width="280" VerticalContentAlignment="Center" ToolTip="Cole aqui o link do YouTube" TextChanged="YoutubeUrlBox_TextChanged"/>
    <Button x:Name="LoadYoutubeButton" Content="Carregar YouTube" Click="LoadYoutube_Click"/>
    <Button x:Name="PlayNextButton" Content="Tocar próxima" Click="PlayNextPrepared_Click" IsEnabled="False"/>
    <Button Content="Conectar Holyrics" Click="HolyricsSettings_Click" Background="#087F9E" ToolTip="Configurar endereço, porta e token e testar a conexão com o Holyrics"/>
    <Button Content="🩺 Diagnóstico" Click="Diagnostics_Click" ToolTip="Confere Holyrics, permissões, microfone, monitores e internet"/>
    <Button Content="☁ Backup" Click="Backup_Click" ToolTip="Backup da biblioteca em uma pasta (OneDrive, Google Drive, pendrive) e restauração"/>
    <Button x:Name="RequestsButton" Content="📥 Pedidos (0)" Click="Requests_Click" ToolTip="Músicas enviadas pelas pessoas pelo link de pedidos"/>
    <Button Content="📱 Celular" Click="Remote_Click" ToolTip="Controlar a aba Bíblia pelo celular (QR code e PIN)"/>
    <Button x:Name="PinTopButton" Content="📌 Fixar à frente" Click="PinTop_Click" ToolTip="Mantém o Lyravoxen sempre à frente (útil contra a janela Apresentação Rápida do Holyrics)"/>
    <Button Content="📋 Relatório" Click="Report_Click" ToolTip="Copia o relatório de uso e erros para colar na conversa"/>
    <Button x:Name="LocalProjectionToggleButton" Content="Abrir projeção própria" Click="OpenLocalProjection_Click" ToolTip="Abrir ou fechar a tela independente de projeção"/>
    <Button Content="Escolher fundo" Click="SelectProjectionBackground_Click" ToolTip="Importar um fundo JPG ou PNG para a projeção própria"/>
    <CheckBox x:Name="HolyricsEnabledBox" Content="Holyrics ativo" IsChecked="True" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0" Checked="HolyricsEnabled_Changed" Unchecked="HolyricsEnabled_Changed" ToolTip="Desativar interrompe o envio e fecha a apresentação rápida, sem encerrar o Holyrics"/>
    <Button Content="Sair da projeção" Click="ExitProjection_Click" Background="#8C3B3B" ToolTip="Fechar a projeção própria e a apresentação atual do Holyrics"/>
    <Button Content="Encerrar música" Click="EndPlaybackManually_Click" Background="#8C3B3B" ToolTip="Parar a música e fechar a projeção no Lyravoxen e no Holyrics"/>
   </WrapPanel>
   <TextBlock x:Name="UrlLyricsHintText" Foreground="#B8CAD5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="6,4,6,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.62*"/><ColumnDefinition Width="1.38*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#07172C" CornerRadius="12" Padding="8" Margin="0,0,8,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="REPRODUÇÃO — PLAYER OFICIAL DO YOUTUBE" Foreground="{StaticResource TextMuted}" Margin="8"/>
     <wv2:WebView2 x:Name="YoutubePlayer" Grid.Row="1"/>
     <MediaElement x:Name="LocalAudioPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="LocalAudioPlayer_MediaEnded" MediaFailed="LocalAudioPlayer_MediaFailed"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="8,0,0,0">
    <TabControl x:Name="SyncTabs" Background="{StaticResource Panel}" BorderThickness="0">
     <TabItem Header="Sincronização">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="SINCRONIZAÇÃO DA LETRA" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,8"/>
       <Grid Grid.Row="1" Margin="3,0,3,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="INTÉRPRETE" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/><TextBox x:Name="MusicArtistBox" Height="30" FontSize="11" Padding="6,4" ToolTip="Intérprete" LostFocus="MusicMetadata_LostFocus" Margin="2"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="TÍTULO DA MÚSICA" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/><TextBox x:Name="MusicTrackBox" Height="30" FontSize="11" Padding="6,4" ToolTip="Título da música" LostFocus="MusicMetadata_LostFocus" Margin="2"/></StackPanel>
        <Button Grid.Column="2" Content="Buscar letra" Click="SearchLyrics_Click" Background="#087F9E" Margin="2,13,2,2" Padding="12,4"/>
        <Button Grid.Column="3" Content="✨ Corrigir nomes" Click="FixNames_Click" Margin="2,13,4,2" Padding="12,4" ToolTip="Separa intérprete e título a partir do título do vídeo e tira Playback, Legendado, Ao vivo etc."/>
       </Grid>
       <StackPanel Grid.Row="2" Margin="4,0,4,6">
        <TextBlock x:Name="LinkLyricsStatusText" Foreground="#F2F6F8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Button x:Name="UseCatalogLyricsButton" Content="Usar esta letra" Click="UseCatalogLyrics_Click" Visibility="Collapsed" Background="#087F9E" HorizontalAlignment="Left" Padding="14,6" Margin="0,6,0,0"/>
       </StackPanel>
       <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,0,4,8"><TextBlock Text="Linhas:" Foreground="#F2F6F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="LineCountBox" Width="64" SelectedIndex="3" SelectionChanged="LineCount_SelectionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox><TextBlock Text="A aparência do telão é controlada pelo Holyrics." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,5,0"/></StackPanel>
       <Border Grid.Row="4" Background="#102C4C" BorderBrush="#1D719B" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="4,2,4,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="PRÉVIA AO VIVO — O QUE ESTÁ SENDO PROJETADO" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" Margin="2,0,2,8"/>
         <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxHeight="760">
          <Border Width="1280" Height="720" Background="#07172C" BorderBrush="#6B8798" BorderThickness="2" CornerRadius="8" Padding="64" MinWidth="800">
           <TextBlock x:Name="ProjectionPreviewText" Text="Aguardando uma frase sincronizada..." Foreground="#F2F6F8" FontSize="58" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
         </Viewbox>
         <TextBlock x:Name="NextProjectionPreviewText" Grid.Row="2" Text="Próxima: —" Foreground="#B8CAD5" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
       </Border>
      </Grid>
     </TabItem>
     <TabItem x:Name="ManualControlsTab" Header="Controles manuais">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ListBox x:Name="CueList" Grid.Row="0" Background="#071A3B" Foreground="#F2F6F8" BorderBrush="#245B88" SelectionChanged="CueList_SelectionChanged" Margin="4"/>
       <UniformGrid Grid.Row="1" Columns="4" Margin="2,2,2,4">
        <Button Content="◀ Anterior" Click="PreviousCue_Click"/>
        <Button Content="Próxima ▶" Click="NextCue_Click"/>
        <Button Content="Projetar selecionada" Click="ProjectSelectedCue_Click" Background="#087F9E"/>
        <Button Content="Modo automático" Click="ResumeAutomaticProjection_Click"/>
       </UniformGrid>
       <UniformGrid Grid.Row="2" Columns="4" Margin="2,2,2,4">
        <Button Content="Editar selecionada" Click="EditCue_Click"/>
        <Button Content="Atualizar frase" Click="UpdateCue_Click"/>
        <Button Content="Excluir frase" Click="DeleteCue_Click"/>
        <Button Content="↑ / ↓ Reordenar" Click="MoveCue_Click"/>
       </UniformGrid>
       <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="SecondsBox" Grid.Column="0" Text="0" ToolTip="Tempo em segundos"/>
         <TextBox x:Name="LyricTextBox" Grid.Column="1" ToolTip="Digite a frase da letra"/>
         <Button Grid.Column="2" Content="Adicionar tempo" Click="AddCue_Click"/>
        </Grid>
        <Button Content="Marcar frase no tempo atual" Click="MarkCueAtCurrentTime_Click" Background="#087F9E"/>
        <TextBlock Text="Para antecipar a projeção, marque cerca de 1,5 segundo antes de a frase começar. O horário registrado não será alterado automaticamente." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="5,3"/>
        <Button Content="Importar letra sincronizada (.LRC / .SRT)" Click="ImportLyrics_Click" Margin="0,6,0,0"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="Histórico de vídeos">
      <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="VÍDEOS UTILIZADOS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Margin="4,4,4,10"/>
       <Grid Grid.Row="1" Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <TextBox x:Name="HistorySearchBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Pesquisar pelo título do vídeo" TextChanged="HistorySearch_TextChanged"/>
