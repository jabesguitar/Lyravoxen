        </GroupStyle>
       </ListBox.GroupStyle>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>

     <DockPanel Grid.Column="1" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="CAPÍTULOS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="4,0,0,5"/>
