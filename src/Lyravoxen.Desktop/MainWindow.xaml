        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock Grid.Row="0" x:Name="BiblePreviewReferenceText" Text="Nenhum versículo selecionado" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
        <TextBlock x:Name="BiblePreviewVerseText" Text="Digite uma referência ou escolha livro, capítulo e versículo." Foreground="#F2F6F8" FontSize="19" TextWrapping="Wrap" LineHeight="28"/>
